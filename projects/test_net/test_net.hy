// ========================================
// zuzo 网络库测试
// 展示：HTTP 获取/提交/更新/删除 + URL 编解码 + 完整请求
// ========================================

打印("=== zuzo 网络库测试 ===")
打印("")

// --- 1. URL 编解码 ---
打印("--- URL 编解码 ---")
变量 原始 = "你好世界 hello world&foo=bar"
变量 编码后 = url编码(原始)
变量 解码后 = url解码(编码后)
打印(f"原始: {原始}")
打印(f"编码: {编码后}")
打印(f"解码: {解码后}")
打印("")

// --- 2. HTTP 获取 ---
打印("--- HTTP 获取 ---")
变量 响应 = http获取("https://httpbin.org/get")
打印(f"获取响应长度: {长度(响应)}")
打印(响应)
打印("")

// --- 3. HTTP 提交 ---
打印("--- HTTP 提交 ---")
变量 提交内容 = "{\"name\": \"zuzo\", \"version\": 1}"
变量 提交响应 = http提交("https://httpbin.org/post", 提交内容)
打印(f"提交响应长度: {长度(提交响应)}")
打印(提交响应)
打印("")

// --- 4. HTTP 更新 ---
打印("--- HTTP 更新 ---")
变量 更新内容 = "{\"updated\": true}"
变量 更新响应 = http更新("https://httpbin.org/put", 更新内容)
打印(f"更新响应长度: {长度(更新响应)}")
打印(更新响应)
打印("")

// --- 5. HTTP 删除 ---
打印("--- HTTP 删除 ---")
变量 删除响应 = http删除("https://httpbin.org/delete")
打印(f"删除响应长度: {长度(删除响应)}")
打印(删除响应)
打印("")

// --- 6. 完整 HTTP 请求（带自定义头）---
打印("--- 完整 HTTP 请求 ---")
变量 请求头 = {
    "X-Custom-Header": "zuzo-lang",
    "Accept": "application/json"
}
变量 完整响应 = http请求("GET", "https://httpbin.org/get", "", 请求头)
打印(f"状态码: {完整响应["状态码"]}")
打印(f"响应体长度: {长度(完整响应["响应体"])}")
打印(f"响应头 Content-Type: {完整响应["响应头"]["Content-Type"]}")
打印("")

打印("=== 网络库测试完成 ===")
