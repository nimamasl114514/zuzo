// ========================================
// zuzo 性能基准测试 3：并发求和
// 测试：goroutine 启动 + channel 通信开销
// ========================================

函数 计算(开始, 结束) {
    变量 总和 = 0
    对于 i = 开始; i < 结束; i = i + 1 {
        总和 = 总和 + i
    }
    返回 总和
}

// --- 并发 4 路 ---
变量 ch1 = 并发(函数() { 返回 计算(0, 250000) })
变量 ch2 = 并发(函数() { 返回 计算(250000, 500000) })
变量 ch3 = 并发(函数() { 返回 计算(500000, 750000) })
变量 ch4 = 并发(函数() { 返回 计算(750000, 1000000) })
变量 r1 = 等待全部(ch1, ch2, ch3, ch4)
变量 并发结果 = r1[0] + r1[1] + r1[2] + r1[3]
打印(f"并发 4 路求和(0..1000000) = {并发结果}")

// --- 串行对比 ---
变量 串行结果 = 计算(0, 1000000)
打印(f"串行求和(0..1000000) = {串行结果}")
