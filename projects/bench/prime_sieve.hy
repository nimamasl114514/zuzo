// ========================================
// zuzo 性能基准测试 2：素数筛（埃拉托斯特尼筛法）
// 测试：循环 + 数组索引操作
// ========================================

函数 素数筛(上限) {
    变量 is_prime = []
    变量 i = 0
    当 i < 上限 {
        推入(is_prime, 1)
        i = i + 1
    }
    is_prime[0] = 0
    is_prime[1] = 0

    变量 j = 2
    当 j * j < 上限 {
        如果 is_prime[j] == 1 {
            变量 k = j * j
            当 k < 上限 {
                is_prime[k] = 0
                k = k + j
            }
        }
        j = j + 1
    }

    变量 计数 = 0
    变量 m = 2
    当 m < 上限 {
        如果 is_prime[m] == 1 {
            计数 = 计数 + 1
        }
        m = m + 1
    }

    返回 计数
}

打印(f"100000 以内素数个数: {素数筛(100000)}")
