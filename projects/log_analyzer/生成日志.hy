// ========================================
// zuzo 实战项目：并发日志分析系统
// 第一步：生成 3 个示例日志文件
// ========================================

打印("=== 生成示例日志文件 ===")

// --- 生成 server1.log（主要含 INFO 和少量 ERROR）---
写文件("server1.log", "[2024-01-01 10:00:01] [INFO]  [192.168.1.10] 服务启动成功\n[2024-01-01 10:00:05] [INFO]  [192.168.1.10] 加载配置文件完成\n[2024-01-01 10:01:30] [INFO]  [192.168.1.11] 用户 admin 登录\n[2024-01-01 10:02:15] [WARN]  [192.168.1.11] 磁盘使用率 85%\n[2024-01-01 10:03:00] [INFO]  [192.168.1.12] 用户 guest 登录\n[2024-01-01 10:05:22] [ERROR] [192.168.1.12] 数据库连接超时\n[2024-01-01 10:05:25] [ERROR] [192.168.1.12] 重试连接失败\n[2024-01-01 10:06:00] [INFO]  [192.168.1.10] 数据库连接恢复\n[2024-01-01 10:08:00] [INFO]  [192.168.1.13] 用户 alice 登录\n[2024-01-01 10:10:30] [WARN]  [192.168.1.13] 接口响应时间过长\n")

// --- 生成 server2.log（主要含 WARN 和 ERROR）---
写文件("server2.log", "[2024-01-01 10:00:10] [INFO]  [10.0.0.1] 服务启动成功\n[2024-01-01 10:01:00] [WARN]  [10.0.0.1] 内存使用率 78%\n[2024-01-01 10:02:30] [ERROR] [10.0.0.2] 网关连接失败\n[2024-01-01 10:02:35] [ERROR] [10.0.0.2] 网关重试失败\n[2024-01-01 10:03:00] [ERROR] [10.0.0.3] 消息队列堆积\n[2024-01-01 10:04:00] [WARN]  [10.0.0.3] 消费者离线\n[2024-01-01 10:05:00] [INFO]  [10.0.0.1] 消费者重新上线\n[2024-01-01 10:06:30] [ERROR] [10.0.0.4] 认证服务无响应\n[2024-01-01 10:07:00] [WARN]  [10.0.0.4] 熔断器触发\n[2024-01-01 10:08:00] [INFO]  [10.0.0.1] 熔断器恢复\n[2024-01-01 10:09:00] [WARN]  [10.0.0.5] 限流告警\n[2024-01-01 10:10:00] [ERROR] [10.0.0.5] 请求积压超限\n")

// --- 生成 server3.log（主要含 INFO）---
写文件("server3.log", "[2024-01-01 10:00:00] [INFO]  [172.16.0.1] 服务启动成功\n[2024-01-01 10:00:30] [INFO]  [172.16.0.1] 健康检查通过\n[2024-01-01 10:01:00] [INFO]  [172.16.0.2] 用户 bob 登录\n[2024-01-01 10:02:00] [INFO]  [172.16.0.3] 用户 charlie 登录\n[2024-01-01 10:03:00] [INFO]  [172.16.0.1] 定时任务执行\n[2024-01-01 10:04:00] [WARN]  [172.16.0.2] 登录失败 3 次\n[2024-01-01 10:05:00] [INFO]  [172.16.0.4] 用户 david 登录\n[2024-01-01 10:06:00] [INFO]  [172.16.0.1] 数据备份完成\n")

打印("已生成 3 个日志文件：server1.log, server2.log, server3.log")
打印("")
