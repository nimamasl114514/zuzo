// ========================================
// zuzo 实战项目：并发日志分析系统
// 第二步：并发读取 3 个日志文件，分析并输出报告
// 展示：文件 I/O + 并发 + 字符串处理 + 数组操作
// ========================================

打印("=== 并发日志分析器 ===")
打印("")

// --- 分析单个日志文件的函数 ---
// 返回数组：[错误数, 警告数, 信息数, 总行数, 文件名]
函数 分析文件(文件名) {
    变量 内容 = 读文件(文件名)
    变量 行数组 = 分割(内容, "\n")
    变量 总行数 = 长度(行数组)

    变量 错误数 = 0
    变量 警告数 = 0
    变量 信息数 = 0
    变量 i = 0

    当 i < 总行数 {
        变量 行 = 行数组[i]
        如果 长度(行) > 0 {
            如果 包含(行, "[ERROR]") {
                错误数 = 错误数 + 1
            }
            如果 包含(行, "[WARN]") {
                警告数 = 警告数 + 1
            }
            如果 包含(行, "[INFO]") {
                信息数 = 信息数 + 1
            }
        }
        i = i + 1
    }

    // 空行不计入有效行数
    变量 有效行数 = 错误数 + 警告数 + 信息数

    返回 [错误数, 警告数, 信息数, 有效行数, 文件名]
}

// --- 并发读取 3 个文件 ---
打印("[1/3] 启动 3 个协程并发分析...")

变量 ch1 = 并发(函数() { 返回 分析文件("server1.log") })
变量 ch2 = 并发(函数() { 返回 分析文件("server2.log") })
变量 ch3 = 并发(函数() { 返回 分析文件("server3.log") })

变量 结果数组 = 等待全部(ch1, ch2, ch3)

打印("[2/3] 全部协程完成，汇总结果...")
打印("")

// --- 汇总统计 ---
变量 总错误 = 0
变量 总警告 = 0
变量 总信息 = 0
变量 总有效 = 0
变量 报告 = ""

报告 = "========================================\n"
报告 = f"{报告}       日志分析报告\n"
报告 = f"{报告}========================================\n"
报告 = f"{报告}\n"
报告 = f"{报告}--- 各文件统计 ---\n"
报告 = f"{报告}\n"

变量 idx = 0
当 idx < 长度(结果数组) {
    变量 r = 结果数组[idx]
    变量 文件名 = r[4]
    变量 错误 = r[0]
    变量 警告 = r[1]
    变量 信息 = r[2]
    变量 有效 = r[3]

    总错误 = 总错误 + 错误
    总警告 = 总警告 + 警告
    总信息 = 总信息 + 信息
    总有效 = 总有效 + 有效

    报告 = f"{报告}文件: {文件名}\n"
    报告 = f"{报告}  ERROR: {错误}  WARN: {警告}  INFO: {信息}  总计: {有效} 行\n"
    报告 = f"{报告}\n"

    idx = idx + 1
}

// --- 汇总 ---
报告 = f"{报告}--- 汇总统计 ---\n"
报告 = f"{报告}\n"
报告 = f"{报告}总错误数 (ERROR): {总错误}\n"
报告 = f"{报告}总警告数 (WARN):  {总警告}\n"
报告 = f"{报告}总信息数 (INFO):  {总信息}\n"
报告 = f"{报告}总有效行数:       {总有效}\n"
报告 = f"{报告}\n"

// --- 健康度评估 ---
报告 = f"{报告}--- 健康度评估 ---\n"
变量 错误率 = 0
如果 总有效 > 0 {
    错误率 = 格式化(总错误 * 100 / 总有效, 1)
}
报告 = f"{报告}错误率: {错误率}%\n"

如果 总错误 == 0 {
    报告 = f"{报告}状态: 优秀 - 无错误\n"
}
如果 总错误 > 0 {
    如果 总错误 < 3 {
        报告 = f"{报告}状态: 正常 - 少量错误\n"
    }
    如果 总错误 >= 3 {
        报告 = f"{报告}状态: 告警 - 错误数较多，需排查\n"
    }
}

报告 = f"{报告}========================================\n"

// --- 输出到终端 ---
打印(报告)

// --- 写入报告文件 ---
写文件("分析报告.txt", 报告)
打印("[3/3] 报告已写入 分析报告.txt")
