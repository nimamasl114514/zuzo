// ========================================
// zuzo 实战项目：并发日志分析系统
// 附加工具：中文词频统计
// 展示：字符串分词 + 数组操作 + 冒泡排序
// ========================================

打印("=== 词频统计工具 ===")
打印("")

// 读取日志文件
变量 内容 = 读文件("server1.log")

// 按空白分词
变量 词数组 = 分词(内容)
变量 词数 = 长度(词数组)

打印(f"总词数: {词数}")
打印("")

// --- 统计词频（用两个平行数组：词 + 计数）---
变量 唯一词 = []
变量 计数 = []
变量 i = 0

当 i < 词数 {
    变量 w = 词数组[i]

    // 查找是否已在唯一词数组中
    变量 找到 = 0
    变量 位置 = 0
    变量 j = 0
    当 j < 长度(唯一词) {
        如果 唯一词[j] == w {
            找到 = 1
            位置 = j
        }
        j = j + 1
    }

    如果 找到 == 1 {
        计数[位置] = 计数[位置] + 1
    }
    如果 找到 == 0 {
        推入(唯一词, w)
        推入(计数, 1)
    }

    i = i + 1
}

变量 唯一数 = 长度(唯一词)
打印(f"唯一词数: {唯一数}")
打印("")

// --- 冒泡排序（按词频降序）---
变量 n = 唯一数
变量 a = 0
当 a < n - 1 {
    变量 b = 0
    当 b < n - a - 1 {
        如果 计数[b] < 计数[b + 1] {
            // 交换计数
            变量 tmp = 计数[b]
            计数[b] = 计数[b + 1]
            计数[b + 1] = tmp

            // 交换词
            变量 tmpw = 唯一词[b]
            唯一词[b] = 唯一词[b + 1]
            唯一词[b + 1] = tmpw
        }
        b = b + 1
    }
    a = a + 1
}

// --- 输出 Top 10 ---
打印("--- 词频 Top 10 ---")
变量 显示数 = 10
如果 唯一数 < 10 {
    显示数 = 唯一数
}

变量 k = 0
当 k < 显示数 {
    变量 rank = k + 1
    变量 词 = 唯一词[k]
    变量 次 = 计数[k]
    打印(f"{rank}. {词} ({次} 次)")
    k = k + 1
}

打印("")
打印("--- 分析完成 ---")
