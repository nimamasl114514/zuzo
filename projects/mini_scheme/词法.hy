// 词法.hy — mini Scheme 词法分析
// 输入源码字符串，输出 token 数组。token = {"类型": 字符串, "值": 任意}
// 类型：左括号 / 右括号 / 引用 / 数 / 布尔 / 符号

函数 空白字符(c) {
  返回 c == " " 或者 c == "\n" 或者 c == "\t" 或者 c == "\r"
}

函数 是数字串(词) {
  变量 n = 长度(词)
  如果 n == 0 { 返回 假 }
  变量 i = 0
  如果 词[0] == "-" {
    如果 n == 1 { 返回 假 }
    i = 1
  }
  当 i < n {
    变量 c = 词[i]
    如果 c < "0" 或者 c > "9" { 返回 假 }
    i = i + 1
  }
  返回 真
}

函数 分类词(词) {
  如果 是数字串(词) { 返回 {"类型": "数", "值": 整数(词)} }
  如果 词 == "#t" { 返回 {"类型": "布尔", "值": 真} }
  如果 词 == "#f" { 返回 {"类型": "布尔", "值": 假} }
  返回 {"类型": "符号", "值": 词}
}

函数 词法分析(源) {
  变量 结果 = []
  变量 i = 0
  变量 n = 长度(源)
  当 i < n {
    变量 c = 源[i]
    如果 空白字符(c) {
      i = i + 1
    } 否则 如果 c == "(" {
      推入(结果, {"类型": "左括号", "值": "("})
      i = i + 1
    } 否则 如果 c == ")" {
      推入(结果, {"类型": "右括号", "值": ")"})
      i = i + 1
    } 否则 如果 c == "'" {
      推入(结果, {"类型": "引用", "值": "'"})
      i = i + 1
    } 否则 如果 c == ";" {
      当 i < n 并且 源[i] != "\n" {
        i = i + 1
      }
    } 否则 {
      变量 开始 = i
      当 i < n 并且 非 空白字符(源[i]) 并且 源[i] != "(" 并且 源[i] != ")" {
        i = i + 1
      }
      推入(结果, 分类词(文本.子串(源, 开始, i)))
    }
  }
  返回 结果
}
