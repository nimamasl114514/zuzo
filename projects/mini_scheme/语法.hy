// 语法.hy — 把 token 数组解析成嵌套数组（列表即代码）
// 例：(+ 1 2) → ["+", 1, 2]

函数 读一个(toks, 状态) {
  变量 t = toks[状态["i"]]
  状态["i"] = 状态["i"] + 1
  变量 种类 = t["类型"]
  如果 种类 == "左括号" {
    返回 读列表(toks, 状态)
  } 否则 如果 种类 == "引用" {
    返回 ["quote", 读一个(toks, 状态)]
  }
  返回 t["值"]
}

函数 读列表(toks, 状态) {
  变量 项 = []
  当 状态["i"] < 长度(toks) {
    变量 t = toks[状态["i"]]
    如果 t["类型"] == "右括号" {
      状态["i"] = 状态["i"] + 1
      返回 项
    }
    推入(项, 读一个(toks, 状态))
  }
  返回 项
}

函数 语法分析(toks) {
  变量 状态 = {"i": 0}
  变量 形式 = []
  当 状态["i"] < 长度(toks) {
    推入(形式, 读一个(toks, 状态))
  }
  返回 形式
}

// 一步到位：源码 → 表达式列表
函数 解析(源) {
  返回 语法分析(词法分析(源))
}
