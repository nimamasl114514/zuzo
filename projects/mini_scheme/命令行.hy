// 命令行.hy — mini Scheme 的交互式入口（REPL）
// 用法：zuzo 命令行.hy
// 说明：读行() 依赖标准输入，仅解释器支持（C 后端会把 读行 判为不支持并报错）

导入 "词法"
导入 "语法"
导入 "求值"
导入 "内置"

函数 新解释器() {
  返回 安装内置(新环境(空))
}

函数 打印结果(值) {
  如果 是错误(值) {
    打印("错误: " + 值["信息"])
  } 否则 {
    打印("=> " + 显示形式(值))
  }
}

函数 主循环() {
  变量 环境 = 新解释器()
  打印("mini Scheme（输入 退出 结束）")
  当 真 {
    打印不换行2("mini> ")
    变量 行 = 读行()
    如果 行 == 空 { 返回 空 }
    如果 长度(行) == 0 { 跳过 }
    如果 行 == "退出" { 返回 空 }
    变量 结果 = 运行(行, 环境)
    打印结果(结果)
  }
}

// 打印不换行：内置的 display 走 打印，这里用同名包装保持可读
函数 打印不换行2(s) {
  打印(s)
}

主循环()
