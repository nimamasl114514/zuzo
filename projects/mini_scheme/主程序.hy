// 主程序.hy — mini Scheme 的测试驱动
// 每个用例：源程序 + 期望的显示形式；全部跑完打印 PASS/FAIL 统计

导入 "词法"
导入 "语法"
导入 "求值"
导入 "内置"

函数 新解释器() {
  返回 安装内置(新环境(空))
}

函数 跑(源) {
  返回 运行(源, 新解释器())
}

变量 总用例 = 0
变量 通过 = 0
变量 失败明细 = []

函数 校验(名称, 源, 期望) {
  总用例 = 总用例 + 1
  变量 结果 = 跑(源)
  变量 实际 = ""
  如果 是错误(结果) {
    实际 = "错误: " + 结果["信息"]
  } 否则 {
    实际 = 显示形式(结果)
  }
  如果 实际 == 期望 {
    通过 = 通过 + 1
    打印("[通过] " + 名称 + " → " + 实际)
  } 否则 {
    推入(失败明细, 名称 + "：期望 " + 期望 + "，实际 " + 实际)
    打印("[失败] " + 名称 + "：期望 " + 期望 + "，实际 " + 实际)
  }
}

函数 主() {
  打印("=== mini Scheme 用例 ===")
  校验("加法", "(+ 1 2)", "3")
  校验("嵌套算术", "(* 3 (+ 2 5))", "21")
  校验("减法取负", "(- 5)", "-5")
  校验("整数除法", "(/ 7 2)", "3")
  校验("取模", "(modulo 7 3)", "1")
  校验("比较", "(< 1 2)", "#t")
  校验("定义变量", "(define x 10) (+ x 5)", "15")
  校验("条件", "(if (> 3 2) 1 0)", "1")
  校验("条件假分支", "(if (> 2 3) 1 0)", "0")
  校验("函数定义", "(define (sq n) (* n n)) (sq 7)", "49")
  校验("递归阶乘", "(define (fact n) (if (= n 0) 1 (* n (fact (- n 1))))) (fact 5)", "120")
  校验("斐波那契", "(define (fib n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2))))) (fib 10)", "55")
  校验("let 绑定", "(let ((a 2) (b 3)) (+ a b))", "5")
  校验("lambda", "(define f (lambda (x) (* x 2))) (f 21)", "42")
  校验("闭包捕获", "(define (adder n) (lambda (x) (+ x n))) (define add5 (adder 5)) (add5 10)", "15")
  校验("car", "(car (list 1 2 3))", "1")
  校验("cdr", "(cdr (list 1 2 3))", "(2 3)")
  校验("cons", "(cons 1 (list 2 3))", "(1 2 3)")
  校验("length", "(length (list 1 2 3 4))", "4")
  校验("append", "(append (list 1) (list 2 3))", "(1 2 3)")
  校验("quote", "'(1 2 3)", "(1 2 3)")
  校验("引用符号", "'abc", "abc")
  校验("null?", "(null? (list))", "#t")
  校验("number?", "(number? 3)", "#t")
  校验("not", "(not #f)", "#t")
  校验("begin", "(begin (define a 1) (define b 2) (+ a b))", "3")
  校验("set!", "(define y 1) (set! y 42) y", "42")
  校验("注释", "(+ 1 2) ; 行尾注释", "3")
  校验("多行源码", "(define (twice x)
     (* 2 x))
   (twice 8)", "16")
  校验("未绑定变量报错", "(+ 1 nope)", "错误: 未绑定变量: nope")
  校验("参数个数报错", "(define (one a) a) (one 1 2)", "错误: 参数个数不匹配: 期望 1，得到 2")

  打印("=== 汇总 ===")
  打印("总用例=" + 字符串(总用例) + " 通过=" + 字符串(通过) + " 失败=" + 字符串(总用例 - 通过))
  变量 i = 0
  当 i < 长度(失败明细) {
    打印("  - " + 失败明细[i])
    i = i + 1
  }
}

主()
