// 求值.hy — 环境与求值器
// 约定：列表（数组）= 代码；符号（字符串）= 变量名；整数/布尔 = 自求值
// 错误统一用 {"错误": 真, "信息": ...} 传递（不依赖 执行/遇到）

函数 错误对象(信息) {
  返回 {"错误": 真, "信息": 信息}
}

函数 是错误(v) {
  如果 类型(v) == "哈希" {
    返回 包含(键(v), "错误")
  }
  返回 假
}

函数 新环境(外层) {
  返回 {"变量": {}, "外层": 外层}
}

函数 定义变量(环境, 名, 值) {
  环境["变量"][名] = 值
  返回 空
}

函数 查变量(环境, 名) {
  变量 e = 环境
  当 e != 空 {
    变量 表 = e["变量"]
    如果 包含(键(表), 名) {
      返回 表[名]
    }
    e = e["外层"]
  }
  返回 错误对象("未绑定变量: " + 名)
}

函数 设置变量(环境, 名, 值) {
  变量 e = 环境
  当 e != 空 {
    变量 表 = e["变量"]
    如果 包含(键(表), 名) {
      表[名] = 值
      返回 空
    }
    e = e["外层"]
  }
  返回 错误对象("set! 未绑定变量: " + 名)
}

// 依次求值，返回最后一个的值（遇到错误立即短路）
函数 求值序列(体, 环境) {
  变量 结果 = 空
  变量 i = 0
  当 i < 长度(体) {
    结果 = 求值(体[i], 环境)
    如果 是错误(结果) { 返回 结果 }
    i = i + 1
  }
  返回 结果
}

函数 求值(expr, 环境) {
  变量 t = 类型(expr)
  如果 t == "整数" { 返回 expr }
  如果 t == "布尔" { 返回 expr }
  如果 t == "字符串" { 返回 查变量(环境, expr) }
  如果 t == "数组" { 返回 求值列表(expr, 环境) }
  返回 错误对象("无法求值的表达式: " + 字符串(expr))
}

函数 求值列表(expr, 环境) {
  如果 长度(expr) == 0 { 返回 错误对象("空表达式 ()") }
  变量 头 = expr[0]
  如果 类型(头) == "字符串" {
    如果 头 == "quote" { 返回 expr[1] }
    如果 头 == "if" { 返回 求值_if(expr, 环境) }
    如果 头 == "define" { 返回 求值_define(expr, 环境) }
    如果 头 == "set!" { 返回 求值_set(expr, 环境) }
    如果 头 == "lambda" { 返回 求值_lambda(expr, 环境) }
    如果 头 == "let" { 返回 求值_let(expr, 环境) }
    如果 头 == "begin" { 返回 求值序列(子列表(expr, 1), 环境) }
  }
  变量 过程 = 求值(头, 环境)
  如果 是错误(过程) { 返回 过程 }
  变量 实参 = []
  变量 i = 1
  当 i < 长度(expr) {
    变量 v = 求值(expr[i], 环境)
    如果 是错误(v) { 返回 v }
    推入(实参, v)
    i = i + 1
  }
  返回 应用(过程, 实参)
}

// 取列表从 start 起的尾部
函数 子列表(lst, start) {
  变量 结果 = []
  变量 i = start
  当 i < 长度(lst) {
    推入(结果, lst[i])
    i = i + 1
  }
  返回 结果
}

函数 求值_if(expr, 环境) {
  如果 长度(expr) < 3 { 返回 错误对象("if 需要条件与真分支") }
  变量 条件 = 求值(expr[1], 环境)
  如果 是错误(条件) { 返回 条件 }
  如果 条件 != 假 {
    返回 求值(expr[2], 环境)
  }
  如果 长度(expr) >= 4 {
    返回 求值(expr[3], 环境)
  }
  返回 空
}

函数 求值_define(expr, 环境) {
  如果 长度(expr) < 3 { 返回 错误对象("define 需要名字与值") }
  变量 目标 = expr[1]
  如果 类型(目标) == "数组" {
    // (define (f a b) 体...) 语法糖
    变量 名 = 目标[0]
    变量 参数 = 子列表(目标, 1)
    变量 闭包 = {"类型": "闭包", "参数": 参数, "体": 子列表(expr, 2), "环境": 环境}
    定义变量(环境, 名, 闭包)
    返回 名
  }
  变量 值 = 求值(expr[2], 环境)
  如果 是错误(值) { 返回 值 }
  定义变量(环境, 目标, 值)
  返回 目标
}

函数 求值_set(expr, 环境) {
  如果 长度(expr) < 3 { 返回 错误对象("set! 需要名字与值") }
  变量 值 = 求值(expr[2], 环境)
  如果 是错误(值) { 返回 值 }
  返回 设置变量(环境, expr[1], 值)
}

函数 求值_lambda(expr, 环境) {
  如果 长度(expr) < 3 { 返回 错误对象("lambda 需要参数表与体") }
  返回 {"类型": "闭包", "参数": expr[1], "体": 子列表(expr, 2), "环境": 环境}
}

函数 求值_let(expr, 环境) {
  如果 长度(expr) < 3 { 返回 错误对象("let 需要绑定表与体") }
  变量 新 = 新环境(环境)
  变量 绑定 = expr[1]
  变量 i = 0
  当 i < 长度(绑定) {
    变量 对 = 绑定[i]
    变量 值 = 求值(对[1], 环境)
    如果 是错误(值) { 返回 值 }
    定义变量(新, 对[0], 值)
    i = i + 1
  }
  返回 求值序列(子列表(expr, 2), 新)
}

函数 应用(过程, 实参) {
  如果 类型(过程) == "哈希" {
    变量 类别 = 取值(过程, "类型", "")
    如果 类别 == "闭包" { 返回 调用闭包(过程, 实参) }
    如果 类别 == "内置" { 返回 调用内置(过程["名"], 实参) }
  }
  返回 错误对象("不可调用: " + 字符串(过程))
}

函数 调用闭包(闭包, 实参) {
  变量 参数 = 闭包["参数"]
  如果 长度(参数) != 长度(实参) {
    返回 错误对象("参数个数不匹配: 期望 " + 字符串(长度(参数)) + "，得到 " + 字符串(长度(实参)))
  }
  变量 环境 = 新环境(闭包["环境"])
  变量 i = 0
  当 i < 长度(参数) {
    定义变量(环境, 参数[i], 实参[i])
    i = i + 1
  }
  返回 求值序列(闭包["体"], 环境)
}

// 运行一段源码，返回最后一个表达式的结果（或错误对象）
函数 运行(源, 全局环境) {
  变量 形式 = 解析(源)
  返回 求值序列(形式, 全局环境)
}
