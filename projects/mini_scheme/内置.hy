// 内置.hy — mini Scheme 内置过程
// 所有内置以 {"类型": "内置", "名": 名字} 表示，调用时按名字分发（不依赖函数值一等公民）

函数 显示形式(v) {
  变量 t = 类型(v)
  如果 t == "布尔" {
    如果 v { 返回 "#t" }
    返回 "#f"
  }
  如果 t == "数组" {
    变量 片段 = []
    变量 i = 0
    当 i < 长度(v) {
      推入(片段, 显示形式(v[i]))
      i = i + 1
    }
    返回 "(" + 连接(片段, " ") + ")"
  }
  如果 t == "空" { 返回 "()" }
  返回 字符串(v)
}

函数 取数(v, 位置) {
  如果 类型(v) != "整数" {
    返回 错误对象("第 " + 字符串(位置) + " 个参数不是整数: " + 显示形式(v))
  }
  返回 v
}

函数 求和(实参) {
  变量 和 = 0
  变量 i = 0
  当 i < 长度(实参) {
    变量 n = 取数(实参[i], i + 1)
    如果 是错误(n) { 返回 n }
    和 = 和 + n
    i = i + 1
  }
  返回 和
}

函数 求积(实参) {
  变量 积 = 1
  变量 i = 0
  当 i < 长度(实参) {
    变量 n = 取数(实参[i], i + 1)
    如果 是错误(n) { 返回 n }
    积 = 积 * n
    i = i + 1
  }
  返回 积
}

函数 求差(实参) {
  如果 长度(实参) == 0 { 返回 错误对象("- 需要至少 1 个参数") }
  变量 首 = 取数(实参[0], 1)
  如果 是错误(首) { 返回 首 }
  如果 长度(实参) == 1 { 返回 0 - 首 }
  变量 差 = 首
  变量 i = 1
  当 i < 长度(实参) {
    变量 n = 取数(实参[i], i + 1)
    如果 是错误(n) { 返回 n }
    差 = 差 - n
    i = i + 1
  }
  返回 差
}

函数 求商(实参) {
  如果 长度(实参) != 2 { 返回 错误对象("/ 需要 2 个参数") }
  变量 a = 取数(实参[0], 1)
  如果 是错误(a) { 返回 a }
  变量 b = 取数(实参[1], 2)
  如果 是错误(b) { 返回 b }
  如果 b == 0 { 返回 错误对象("除零") }
  返回 a / b
}

函数 求模(实参) {
  如果 长度(实参) != 2 { 返回 错误对象("modulo 需要 2 个参数") }
  变量 a = 取数(实参[0], 1)
  如果 是错误(a) { 返回 a }
  变量 b = 取数(实参[1], 2)
  如果 是错误(b) { 返回 b }
  如果 b == 0 { 返回 错误对象("modulo 除零") }
  返回 a % b
}

函数 比较数(符号, 实参) {
  如果 长度(实参) != 2 { 返回 错误对象(符号 + " 需要 2 个参数") }
  变量 a = 取数(实参[0], 1)
  如果 是错误(a) { 返回 a }
  变量 b = 取数(实参[1], 2)
  如果 是错误(b) { 返回 b }
  如果 符号 == "=" { 返回 a == b }
  如果 符号 == "<" { 返回 a < b }
  如果 符号 == ">" { 返回 a > b }
  如果 符号 == "<=" { 返回 a <= b }
  返回 a >= b
}

函数 首个(lst) {
  如果 类型(lst) != "数组" { 返回 错误对象("car 需要列表") }
  如果 长度(lst) == 0 { 返回 错误对象("car 空列表") }
  返回 lst[0]
}

函数 余下列表(lst) {
  如果 类型(lst) != "数组" { 返回 错误对象("cdr 需要列表") }
  如果 长度(lst) == 0 { 返回 错误对象("cdr 空列表") }
  返回 子列表(lst, 1)
}

函数 调用内置(名, 实参) {
  如果 名 == "+" { 返回 求和(实参) }
  如果 名 == "*" { 返回 求积(实参) }
  如果 名 == "-" { 返回 求差(实参) }
  如果 名 == "/" { 返回 求商(实参) }
  如果 名 == "modulo" { 返回 求模(实参) }
  如果 名 == "=" { 返回 比较数("=", 实参) }
  如果 名 == "<" { 返回 比较数("<", 实参) }
  如果 名 == ">" { 返回 比较数(">", 实参) }
  如果 名 == "<=" { 返回 比较数("<=", 实参) }
  如果 名 == ">=" { 返回 比较数(">=", 实参) }

  如果 名 == "car" { 返回 首个(实参[0]) }
  如果 名 == "cdr" { 返回 余下列表(实参[0]) }
  如果 名 == "cons" {
    变量 新表 = [实参[0]]
    变量 尾 = 实参[1]
    变量 i = 0
    当 i < 长度(尾) {
      推入(新表, 尾[i])
      i = i + 1
    }
    返回 新表
  }
  如果 名 == "list" { 返回 实参 }
  如果 名 == "length" { 返回 长度(实参[0]) }
  如果 名 == "append" {
    变量 合并 = []
    变量 i = 0
    当 i < 长度(实参) {
      变量 段 = 实参[i]
      变量 j = 0
      当 j < 长度(段) {
        推入(合并, 段[j])
        j = j + 1
      }
      i = i + 1
    }
    返回 合并
  }

  如果 名 == "null?" { 返回 类型(实参[0]) == "数组" 并且 长度(实参[0]) == 0 }
  如果 名 == "number?" { 返回 类型(实参[0]) == "整数" }
  如果 名 == "symbol?" { 返回 类型(实参[0]) == "字符串" }
  如果 名 == "list?" { 返回 类型(实参[0]) == "数组" }
  如果 名 == "not" {
    如果 实参[0] == 假 { 返回 真 }
    返回 假
  }
  如果 名 == "abs" {
    如果 实参[0] < 0 { 返回 0 - 实参[0] }
    返回 实参[0]
  }
  如果 名 == "display" {
    打印不换行(显示形式(实参[0]))
    返回 空
  }
  如果 名 == "newline" {
    打印("")
    返回 空
  }
  返回 错误对象("未知内置过程: " + 名)
}

函数 打印不换行(s) {
  打印(s)
}

// 把内置过程装进全局环境
函数 安装内置(环境) {
  变量 名字表 = ["+", "-", "*", "/", "modulo", "=", "<", ">", "<=", ">=",
    "car", "cdr", "cons", "list", "length", "append",
    "null?", "number?", "symbol?", "list?", "not", "abs", "display", "newline"]
  变量 i = 0
  当 i < 长度(名字表) {
    定义变量(环境, 名字表[i], {"类型": "内置", "名": 名字表[i]})
    i = i + 1
  }
  返回 环境
}
