// ========================================
// zuzo 标准库综合测试
// JSON + 正则 + 数学 + 时间
// ========================================

打印("=== zuzo 标准库综合测试 ===")
打印("")

// ========== 1. JSON ==========
打印("--- JSON ---")

// 解析
变量 data = json解析("{\"name\": \"zuzo\", \"version\": 1, \"tags\": [\"lang\", \"go\"], \"active\": true}")
打印(f"名称: {data["name"]}")
打印(f"版本: {data["version"]}")
打印(f"标签数: {长度(data["tags"])}")
打印(f"标签0: {data["tags"][0]}")
打印(f"活跃: {data["active"]}")

// 序列化
变量 obj = {"城市": "北京", "温度": 28.5, "晴天": 真}
变量 jsonStr = json序列化(obj)
打印(f"序列化: {jsonStr}")

// 格式化
变量 pretty = json格式化(obj, "  ")
打印("格式化:")
打印(pretty)
打印("")

// ========== 2. 正则表达式 ==========
打印("--- 正则表达式 ---")

变量 text = "订单号: ABC123, 金额: ¥456.78, 日期: 2024-01-15"

// 匹配
变量 m = 正则匹配(text, "(\\d+)-(\\d+)-(\\d+)")
如果 m != 空 {
    打印(f"日期匹配: {m[0]}")
    打印(f"年: {m[1]} 月: {m[2]} 日: {m[3]}")
}

// 查找全部
变量 numbers = 正则查找全部(text, "\\d+")
打印("所有数字:")
变量 i = 0
当 i < 长度(numbers) {
    打印(f"  {numbers[i][0]}")
    i = i + 1
}

// 替换
变量 masked = 正则替换(text, "\\d+", "***")
打印(f"脱敏: {masked}")

// 验证
打印(f"邮箱验证: {正则验证("test@example.com", "^[a-z]+@[a-z]+\\.[a-z]+$")}")
打印(f"邮箱验证: {正则验证("not-an-email", "^[a-z]+@[a-z]+\\.[a-z]+$")}")

// 提取
变量 amount = 正则提取(text, "¥[\\d.]+")
打印(f"金额提取: {amount}")
打印("")

// ========== 3. 数学 ==========
打印("--- 数学 ---")
打印(f"随机数: {随机()}")
打印(f"随机整数(1,100): {随机整数(1, 100)}")
打印(f"绝对值(-42): {绝对值(-42)}")
打印(f"最大值(3,7,2,9,1): {最大值(3, 7, 2, 9, 1)}")
打印(f"最小值(3,7,2,9,1): {最小值(3, 7, 2, 9, 1)}")
打印(f"向上取整(3.14): {向上取整(3.14)}")
打印(f"向下取整(3.99): {向下取整(3.99)}")
打印(f"四舍五入(3.5): {四舍五入(3.5)}")
打印(f"幂(2,10): {幂(2, 10)}")
打印(f"平方根(144): {平方根(144)}")
打印(f"正弦(0): {正弦(0)}")
打印(f"余弦(0): {余弦(0)}")
打印(f"对数(2.71828): {对数(2.71828)}")
打印(f"对数(100,10): {对数(100, 10)}")
打印("")

// ========== 4. 时间 ==========
打印("--- 时间 ---")
变量 ts = 时间戳()
打印(f"时间戳: {ts}")
打印(f"毫秒时间戳: {毫秒时间戳()}")
打印(f"当前时间: {当前时间()}")
打印(f"格式化时间: {格式化时间(ts, "2006-01-02 15:04:05")}")
打印(f"解析时间: {解析时间("2024-01-15 12:30:00", "2006-01-02 15:04:05")}")

// 睡眠 + 计时
打印("计时测试...")
变量 elapsed = 计时(函数() {
    睡眠(100)
})
打印(f"睡眠 100ms 实际耗时: {elapsed} ms")

变量 elapsedSec = 计时秒(函数() {
    睡眠(50)
})
打印(f"睡眠 50ms 实际耗时: {elapsedSec} 秒")

// 时间差
变量 t1 = 解析时间("2024-01-01 00:00:00", "2006-01-02 15:04:05")
变量 t2 = 解析时间("2024-01-02 12:30:00", "2006-01-02 15:04:05")
打印(f"时间差: {时间差(t1, t2)}")
打印("")

// ========== 5. 综合实战：模拟 API 调用 ==========
打印("--- 综合实战 ---")

函数 生成随机用户() {
    变量 names = ["张三", "李四", "王五", "赵六", "钱七"]
    变量 idx = 随机整数(0, 长度(names) - 1)
    变量 name = names[idx]
    变量 age = 随机整数(18, 65)
    变量 score = 格式化(随机() * 100, 1)
    变量 ts = 时间戳()

    返回 {"name": name, "age": age, "score": score, "ts": ts}
}

变量 user = 生成随机用户()
打印("随机用户:")
打印(json格式化(user, "  "))

// 模拟写入日志
变量 logLine = f"{格式化时间(user["ts"], "2006-01-02 15:04:05")} | 用户={user["name"]} 年龄={user["age"]} 分数={user["score"]}"
打印(f"日志行: {logLine}")

// 用正则解析日志行
变量 parsed = 正则匹配(logLine, "(.+\\|).+用户=(.+) 年龄=(\\d+) 分数=(.+)")
如果 parsed != 空 {
    打印("解析日志:")
    打印(f"  时间段: {去空白(parsed[1])}")
    打印(f"  用户名: {parsed[2]}")
    打印(f"  年龄: {parsed[3]}")
    打印(f"  分数: {parsed[4]}")
}

打印("")
打印("=== 标准库测试完成 ===")
