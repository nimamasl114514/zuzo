// t16 文本命名空间扩展（27 成员）
打印(文本.首字母大写("hello WORLD"))
打印(文本.标题化("hello world"))
打印(文本.大小写互换("AbC"))
打印(文本.去左空白("  x  "), "|")
打印(文本.去右空白("  x  "), "|")
打印(文本.去前缀("prefix-body", "prefix-"))
打印(文本.去后缀("a.txt", ".txt"))
打印(文本.替换次("aaa", "a", "b", 2))
打印(文本.分割次("a,b,c", ",", 2))
打印(文本.左对齐("hi", 6, "-"))
打印(文本.右对齐("hi", 6, "-"))
打印(文本.居中("hi", 7, "-"))
打印(文本.大写("abc"), 文本.小写("ABC"), 文本.去空白(" x "))
打印(文本.重复("ab", 3), 文本.比较("a", "b"))
打印(文本.子串("你好世界", 1, 3), 文本.查找("hello", "ll"))
打印(文本.按行分割("a\nb"), 文本.分割("a,b", ","))
