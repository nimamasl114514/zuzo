// t05 for 循环（单层 + 嵌套 + continue）
变量 乘积 = 1
对于 i = 1; i <= 10; i = i + 1 {
    乘积 = 乘积 * i
}
打印(乘积)

对于 i = 0; i < 3; i = i + 1 {
    对于 j = 0; j < 3; j = j + 1 {
        打印(i, j)
    }
}

变量 偶数和 = 0
对于 i = 0; i < 10; i = i + 1 {
    如果 i % 2 != 0 { 跳过 }
    偶数和 = 偶数和 + i
}
打印(偶数和)

// 范围遍历
变量 累计 = 0
对于 k 在 0 到 5 {
    累计 = 累计 + k
}
打印(累计)
