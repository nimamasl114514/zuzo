函数 除(a, b) {
  返回 a / b
}

执行 {
  变量 x = 10 / 0
  打印(x)
} 遇到 e {
  打印("捕获=" + 错误码(e))
}

执行 {
  打印(除(1, 0))
} 遇到 e {
  打印("函数内=" + 错误码(e))
}

执行 {
  变量 i = 0
  当 i < 3 {
    i = i + 1
    变量 y = 1 / 0
  }
} 遇到 e {
  打印("循环内=" + 错误码(e))
}

执行 {
  打印("无错误")
} 遇到 e {
  打印("不该到这里")
}

执行 {
  执行 {
    变量 z = 5 / 0
  } 遇到 e1 {
    打印("内层=" + 错误码(e1))
    变量 z2 = 7 / 0
  }
} 遇到 e2 {
  打印("外层=" + 错误码(e2))
}

打印("结束")
