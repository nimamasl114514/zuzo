// t35 分代 GC 压力用例：长寿命驻留 + 短命洪泛
// 判据（ZUZO_GC_TRACE=1）：出现 minor（freed>0）、出现 major、old 字节数非零（晋升发生）

// ① 长寿命对象：一个持续扩容的数组，从根可达，历经多轮 minor 应晋升到老年代
变量 长存 = []
对于 i = 0; i < 400; i = i + 1 {
    推入(长存, "long-" + "live")
}

// ② 短命对象洪泛：每轮创建数组 + 拼接字符串，随即失去引用
变量 累计 = 0
对于 i = 0; i < 20000; i = i + 1 {
    变量 临时 = [i, i + 1, "abc" + "def"]
    累计 = 累计 + 临时[0]
}

// ③ 老年代垃圾：每轮换一个新桶。桶内对象在创建过程中经历 minor 而晋升；
//    下一轮桶被重新赋值，旧桶连同其元素成为老年代垃圾，应由 major 回收。
变量 桶 = []
对于 轮 = 0; 轮 < 6; 轮 = 轮 + 1 {
    桶 = []
    对于 i = 0; i < 3000; i = i + 1 {
        推入(桶, "payload-" + "0123456789")
    }
}

打印(长度(长存), 累计, 长度(桶))
