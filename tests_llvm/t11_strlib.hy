// t11 文本命名空间核心成员
打印(文本.大写("Hello"))
打印(文本.小写("Hello"))
打印(文本.去空白("  hi  "))
打印(文本.替换("aaa", "a", "b"))
打印(文本.分割("a,b,c", ","))
打印(文本.重复("ab", 3))
打印(文本.查找("你好ab", "a"))
打印(文本.包含("hello", "ell"))
打印(文本.前缀("hello", "he"), 文本.后缀("hello", "lo"))
打印(文本.比较("a", "b"))
打印(文本.子串("你好世界", 1, 3))
打印(文本.按行分割("a\nb\nc"))
