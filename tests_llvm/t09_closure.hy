// t09 闭包：捕获可变状态 / 工厂函数 / 高阶函数
函数 计数器() {
    变量 n = 0
    函数 递增() {
        n = n + 1
        返回 n
    }
    返回 递增
}

变量 c = 计数器()
打印(c())
打印(c())
打印(c())

函数 加法器(n) {
    返回 函数(x) { 返回 x + n }
}
变量 add10 = 加法器(10)
变量 add20 = 加法器(20)
打印(add10(5))
打印(add20(5))

函数 应用(f, x) {
    返回 f(x)
}
打印(应用(函数(n) { 返回 n * 2 }, 21))
