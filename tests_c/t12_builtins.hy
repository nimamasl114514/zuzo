// t12 数组哈希数学内置
变量 a = [3, 1, 2]
推入(a, 9)
打印(a, 弹出(a), a)
打印(首项(a), 末项(a))
变量 h = {"x": 1, "y": 2}
打印(长度(键(h)))
打印(取值(h, "x"), 取值(h, "zz", 42))
打印(计数("aaa", "a"), 计数("hello", "l"))
打印(取字符("你好", 1), 分词("a  b c"))
打印(裁剪("xxhixx", "x"))
打印(绝对值(-5), 最大值(3, 7), 最小值(3, 7))
打印(向上取整(3.2), 向下取整(3.8), 四舍五入(3.5))
打印(幂(2, 10), 平方根(144.0))
打印(正弦(0.0), 余弦(0.0), 对数(1.0))
打印(大写("abc"), 小写("ABC"), 前缀("hello", "he"), 后缀("hello", "lo"))
打印(查找("hello", "ll"), 替换("aaa", "a", "b"), 分割("a,b", ","))
打印(去空白("  x  "), 重复("ab", 2))
