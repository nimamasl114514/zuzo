// strlib_test.hy — 字符串标准库（文本 命名空间）端到端 BDD 用例
//
// 运行：./zuzo.exe tests/strlib_test.hy
// 判定：输出「0 失败」

测试套件("文本库 · 大小写", 函数() {

    测试用例("基本大小写", 函数() {
        断言相等(文本.大写("hello"), "HELLO")
        断言相等(文本.小写("HELLO"), "hello")
        断言相等(文本.大写("abc中文"), "ABC中文")
    })

    测试用例("变体大小写", 函数() {
        断言相等(文本.首字母大写("hello WORLD"), "Hello world")
        断言相等(文本.标题化("hello world"), "Hello World")
        断言相等(文本.大小写互换("AbC"), "aBc")
        断言相等(文本.大小写折叠("Straße"), "strasse")
    })

    测试用例("比较", 函数() {
        断言为真(文本.忽略大小写相等("AbC", "aBc"))
        断言相等(文本.比较("a", "b"), -1)
        断言相等(文本.比较("a", "a"), 0)
        断言相等(文本.比较("b", "a"), 1)
    })
})

测试套件("文本库 · 裁剪与前后缀", 函数() {

    测试用例("裁剪", 函数() {
        断言相等(文本.去空白("  hi  "), "hi")
        断言相等(文本.裁剪("xxhiyy", "xy"), "hi")
        断言相等(文本.左裁剪("xxhi", "x"), "hi")
        断言相等(文本.右裁剪("hixx", "x"), "hi")
        断言相等(文本.去左空白("  hi"), "hi")
        断言相等(文本.去右空白("hi  "), "hi")
    })

    测试用例("前后缀", 函数() {
        断言相等(文本.去前缀("prefix-body", "prefix-"), "body")
        断言相等(文本.去后缀("a.txt", ".txt"), "a")
        断言为真(文本.前缀("hello", "he"))
        断言为真(文本.后缀("hello", "lo"))
        断言为真(文本.前缀任一("hello", ["xx", "he"]))
        断言为真(文本.后缀任一("hello", ["xx", "lo"]))
    })
})

测试套件("文本库 · 查找与替换", 函数() {

    测试用例("查找", 函数() {
        断言相等(文本.查找("hello", "ll"), 2)
        断言相等(文本.查找("hello", "zz"), -1)
        断言相等(文本.查找("你好ab", "a"), 2)
        断言相等(文本.反向查找("a.b.c", "."), 3)
        断言相等(文本.查找任一("hello", "lo"), 2)
        断言相等(文本.反向查找任一("hello", "lo"), 4)
        断言相等(文本.查找字符("hello", "l"), 2)
        断言为真(文本.包含("hello", "ell"))
        断言为假(文本.包含任一("hello", "xyz"))
    })

    测试用例("计数与替换", 函数() {
        断言相等(文本.计数("aaa", "a"), 3)
        断言相等(文本.替换("aaa", "a", "b"), "bbb")
        断言相等(文本.替换次("aaa", "a", "b", 2), "bba")
        断言相等(文本.批量替换("a+b=c", {"a": "1", "b": "2", "c": "3"}), "1+2=3")
        断言相等(文本.替换字符("abc", {"a": "1", "b": "2"}), "12c")
    })
})

测试套件("文本库 · 分割与连接", 函数() {

    测试用例("分割", 函数() {
        断言相等(文本.分割("a,b,c", ","), ["a", "b", "c"])
        断言相等(文本.分割次("a,b,c", ",", 2), ["a", "b,c"])
        断言相等(文本.分割("abc", ""), ["a", "b", "c"])
        断言相等(文本.按行分割("a\nb\r\nc"), ["a", "b", "c"])
        断言相等(文本.分词("a  b\tc"), ["a", "b", "c"])
    })

    测试用例("位置分割", 函数() {
        断言相等(文本.位置分割("a=b", "="), ["a", "=", "b"])
        断言相等(文本.位置分割("abc", "="), ["abc", "", ""])
        断言相等(文本.反向位置分割("a.b.c", "."), ["a.b", ".", "c"])
        断言相等(文本.反向位置分割("abc", "="), ["", "", "abc"])
        断言相等(文本.连接(["a", "b", "c"], "-"), "a-b-c")
    })
})

测试套件("文本库 · 对齐与填充", 函数() {

    测试用例("对齐", 函数() {
        断言相等(文本.左对齐("hi", 6, "-"), "hi----")
        断言相等(文本.右对齐("hi", 6, "-"), "----hi")
        断言相等(文本.居中("hi", 6, "-"), "--hi--")
        断言相等(文本.居中("hi", 7, "-"), "---hi--")
        断言相等(文本.零填充("-42", 5), "-0042")
        断言相等(文本.重复("ab", 3), "ababab")
        断言相等(文本.展开制表符("a\tb", 4), "a   b")
    })
})

测试套件("文本库 · 字符判定", 函数() {

    测试用例("数字类", 函数() {
        断言为真(文本.是数字("123"))
        断言为假(文本.是数字(""))
        断言为真(文本.是十进制("123"))
        断言为真(文本.是数值("123"))
        断言为假(文本.是数字("12a"))
    })

    测试用例("字母与空白", 函数() {
        断言为真(文本.是字母("abc中文"))
        断言为真(文本.是字母数字("a1中"))
        断言为真(文本.是空白(" \t\n"))
        断言为假(文本.是空白(" a"))
    })

    测试用例("大小写与标题", 函数() {
        断言为真(文本.是大写("ABC中"))
        断言为假(文本.是大写("ABc"))
        断言为真(文本.是小写("abc中"))
        断言为真(文本.是标题("Hello World"))
        断言为假(文本.是标题("Hello world"))
    })

    测试用例("其他判定", 函数() {
        断言为真(文本.是可打印("abc 中"))
        变量 控制串 = "a" + 文本.码点转字符(0) + "b"
        断言为假(文本.是可打印(控制串))
        断言为真(文本.是标识符("a1_中"))
        断言为假(文本.是标识符("1a"))
        断言为真(文本.是ASCII("abc"))
        断言为假(文本.是ASCII("a中"))
    })
})

测试套件("文本库 · 子串与反转", 函数() {

    测试用例("取字符与切片", 函数() {
        断言相等(文本.取字符("hello", 1), "e")
        断言相等(文本.子串("hello", 1, 4), "ell")
        断言相等(文本.子串("hello", -3, -1), "ll")
        断言相等(文本.子串("hello", 3, 100), "lo")
        断言相等(文本.子串("hello", 4, 2), "")
        断言相等(文本.子串("你好世界", 1, 3), "好世")
    })

    测试用例("左右与反转", 函数() {
        断言相等(文本.取左("hello", 2), "he")
        断言相等(文本.取右("hello", 2), "lo")
        断言相等(文本.反转("你好abc"), "cba好你")
    })
})

测试套件("文本库 · 中文友好", 函数() {

    测试用例("显示宽度", 函数() {
        断言相等(文本.显示宽度("你好ab"), 6)
        断言相等(文本.显示宽度("，。"), 4)
        断言相等(文本.显示宽度(""), 0)
    })

    测试用例("按宽度处理", 函数() {
        断言相等(文本.按宽度截断("你好世界abc", 6, "…"), "你好…")
        断言相等(文本.按宽度截断("你好", 6, "…"), "你好")
        断言相等(文本.按宽度填充("你好", 8, "-", "左"), "你好----")
        断言相等(文本.按宽度填充("你好", 8, "-", "右"), "----你好")
    })

    测试用例("中文数字", 函数() {
        断言相等(文本.中文数字("一百二十三"), 123)
        断言相等(文本.中文数字("十二"), 12)
        断言相等(文本.中文数字("两万三千"), 23000)
        断言相等(文本.中文数字串(12), "十二")
        断言相等(文本.中文数字串(123), "一百二十三")
        断言相等(文本.中文数字串(10086), "一万零八十六")
    })

    测试用例("中文判定与全半角", 函数() {
        断言为真(文本.包含中文("hello你好"))
        断言为假(文本.包含中文("hello"))
        断言相等(文本.全角转半角("ＡＢＣ１２３"), "ABC123")
        断言相等(文本.半角转全角("ABC123"), "ＡＢＣ１２３")
    })
})

测试套件("文本库 · 复用面与兼容", 函数() {

    测试用例("编码与摘要", 函数() {
        断言相等(文本.base64编码("hello"), "aGVsbG8=")
        断言相等(文本.base64解码("aGVsbG8="), "hello")
        断言相等(文本.hex编码("A"), "41")
        断言相等(长度(文本.md5("abc")), 32)
        断言相等(长度(文本.sha256("abc")), 64)
    })

    测试用例("UTF-8 面", 函数() {
        断言相等(文本.utf8字节数("你好"), 6)
        断言为真(文本.utf8验证("你好"))
        断言相等(文本.字符转码点("A"), 65)
        断言相等(文本.码点转字符(65), "A")
    })

    测试用例("旧全局名零破坏", 函数() {
        断言相等(大写("hello"), "HELLO")
        断言相等(小写("HELLO"), "hello")
        断言相等(查找("hello", "ll"), 2)
        断言相等(替换("aaa", "a", "b"), "bbb")
        断言相等(分割("a,b", ","), ["a", "b"])
        断言相等(取字符("hello", 0), "h")
        断言相等(长度("你好"), 2)
    })
})

运行测试()
