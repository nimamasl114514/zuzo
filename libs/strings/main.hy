// strings — Zuzo 字符串标准库（高层封装）
//
// 定位：底层 110+ 个原子操作由 Go 内建命名空间 `文本` 提供（性能好、UTF-8/Unicode 正确）；
//       本库用 zuzo 自己写「复合能力」——统计、表格、命名法、模板、行处理、中文格式化等。
//
// 用法：
//   导入 "../libs/strings/main.hy" 为 串
//   打印(串.统计("你好 world"))
//   打印(串.摘要("很长的文本……", 10))
//   打印(串.千分位(1234567))
//
// 约定：所有宽度均指「显示宽度」（汉字/全角计 2 列），不是字符数。

// ==================== 文本统计 ====================

// 统计 返回文本的多维统计：字符数 / 字节数 / 显示宽度 / 行数 / 词数 / 中文字数
函数 统计(s) {
    变量 字符数 = 长度(s)
    变量 中文字数 = 0
    对于 i = 0; i < 字符数; i = i + 1 {
        如果 文本.包含中文(文本.取字符(s, i)) {
            中文字数 = 中文字数 + 1
        }
    }
    返回 {
        "字符数": 字符数,
        "字节数": 文本.utf8字节数(s),
        "显示宽度": 文本.显示宽度(s),
        "行数": 长度(文本.按行分割(s)),
        "词数": 长度(文本.分词(s)),
        "中文字数": 中文字数,
        "中文占比": 如果 字符数 > 0 { 中文字数 * 100 / 字符数 } 否则 { 0 }
    }
}

// 摘要 按显示宽度截断并追加省略标记（默认「…」）
函数 摘要(s, 宽) {
    返回 文本.按宽度截断(s, 宽, "…")
}

// 摘要右 保留文本右端（常用于路径/URL 显示），左侧补「…」
函数 摘要右(s, 宽) {
    变量 总 = 文本.显示宽度(s)
    如果 总 <= 宽 {
        返回 s
    }
    变量 目标 = 宽 - 1
    如果 目标 < 0 {
        目标 = 0
    }
    变量 结果 = ""
    变量 已用 = 0
    变量 n = 长度(s)
    对于 i = 0; i < n; i = i + 1 {
        变量 c = 文本.取字符(s, n - 1 - i)
        已用 = 已用 + 文本.显示宽度(c)
        如果 已用 > 目标 {
            返回 "…" + 结果
        }
        结果 = c + 结果
    }
    返回 "…" + 结果
}

// ==================== 表格渲染 ====================

// 表格 把二维数组渲染为按显示宽度对齐的文本表
//   行     = [["姓名","年龄"],["张三",25]]
//   列宽   = [10, 6]（缺省列按内容自适应 = 0）
//   分隔   = " | "
函数 表格(行, 列宽, 分隔) {
    变量 行数 = 长度(行)
    如果 行数 == 0 {
        返回 ""
    }
    变量 列数 = 0
    对于 r = 0; r < 行数; r = r + 1 {
        如果 长度(行[r]) > 列数 {
            列数 = 长度(行[r])
        }
    }
    // 自适应列宽
    变量 宽表 = []
    对于 c = 0; c < 列数; c = c + 1 {
        变量 设定 = 0
        如果 c < 长度(列宽) {
            设定 = 列宽[c]
        }
        如果 设定 > 0 {
            推入(宽表, 设定)
        } 否则 {
            变量 最大 = 0
            对于 r = 0; r < 行数; r = r + 1 {
                如果 c < 长度(行[r]) {
                    变量 w = 文本.显示宽度(文本.转文本(行[r][c]))
                    如果 w > 最大 {
                        最大 = w
                    }
                }
            }
            推入(宽表, 最大)
        }
    }
    // 渲染
    变量 输出 = []
    对于 r = 0; r < 行数; r = r + 1 {
        变量 格 = []
        对于 c = 0; c < 列数; c = c + 1 {
            变量 值 = ""
            如果 c < 长度(行[r]) {
                值 = 文本.转文本(行[r][c])
            }
            推入(格, 文本.按宽度填充(值, 宽表[c], " ", "左"))
        }
        推入(输出, 连接(格, 分隔))
    }
    返回 连接(输出, "\n")
}

// ==================== 命名法转换 ====================

// 拆词 内部助手：把任意命名风格的标识符拆成小写词数组
函数 拆词(s) {
    变量 粗 = 文本.替换(文本.替换(文本.替换(s, "-", " "), "_", " "), ".", " ")
    变量 n = 长度(粗)
    变量 拆 = ""
    对于 i = 0; i < n; i = i + 1 {
        变量 c = 文本.取字符(粗, i)
        如果 i > 0 {
            变量 前 = 文本.取字符(粗, i - 1)
            如果 文本.是大写(c) 并且 文本.是小写(前) {
                拆 = 拆 + " "
            }
        }
        拆 = 拆 + c
    }
    变量 原词 = 文本.分词(拆)
    变量 词 = []
    对于 i = 0; i < 长度(原词); i = i + 1 {
        推入(词, 文本.小写(原词[i]))
    }
    返回 词
}

// 命名法 生成五种常用命名风格
//   返回 {"蛇形": "user_name", "驼峰": "userName", "大驼峰": "UserName",
//         "短横线": "user-name", "常量": "USER_NAME", "全小写": "username"}
函数 命名法(s) {
    变量 词 = 拆词(s)
    如果 长度(词) == 0 {
        返回 {"蛇形": "", "驼峰": "", "大驼峰": "", "短横线": "", "常量": "", "全小写": ""}
    }
    变量 大词 = []
    对于 i = 0; i < 长度(词); i = i + 1 {
        推入(大词, 文本.首字母大写(词[i]))
    }
    变量 驼峰 = 词[0]
    对于 i = 1; i < 长度(词); i = i + 1 {
        驼峰 = 驼峰 + 大词[i]
    }
    返回 {
        "蛇形": 连接(词, "_"),
        "驼峰": 驼峰,
        "大驼峰": 连接(大词, ""),
        "短横线": 连接(词, "-"),
        "常量": 连接(大词转换(词), "_"),
        "全小写": 连接(词, "")
    }
}

// 大词转换 内部助手：词数组全转大写
函数 大词转换(词) {
    变量 结果 = []
    对于 i = 0; i < 长度(词); i = i + 1 {
        推入(结果, 文本.大写(词[i]))
    }
    返回 结果
}

// ==================== 模板渲染 ====================

// 模板 把 {键} 占位替换为变量表中的值
//   模板("你好，{名字}！你今年 {年龄} 岁。", {"名字": "张三", "年龄": 25})
函数 模板(模板串, 变量表) {
    变量 结果 = 模板串
    变量 名 = 键(变量表)
    对于 i = 0; i < 长度(名); i = i + 1 {
        变量 k = 名[i]
        结果 = 文本.替换(结果, "{" + k + "}", 文本.转文本(变量表[k]))
    }
    返回 结果
}

// ==================== 行处理 ====================

// 去重行 按行去重，保持首次出现顺序
函数 去重行(s) {
    变量 行 = 文本.按行分割(s)
    变量 已见 = {}
    变量 输出 = []
    对于 i = 0; i < 长度(行); i = i + 1 {
        如果 取值(已见, 行[i], 空) == 空 {
            已见[行[i]] = 真
            推入(输出, 行[i])
        }
    }
    返回 连接(输出, "\n")
}

// 过滤空行 去掉空行与纯空白行
函数 过滤空行(s) {
    变量 行 = 文本.按行分割(s)
    变量 输出 = []
    对于 i = 0; i < 长度(行); i = i + 1 {
        如果 长度(文本.去空白(行[i])) > 0 {
            推入(输出, 行[i])
        }
    }
    返回 连接(输出, "\n")
}

// 排序行 按字典序排序（冒泡，稳定可读）
函数 排序行(s) {
    变量 行 = 文本.按行分割(s)
    变量 n = 长度(行)
    对于 i = 0; i < n; i = i + 1 {
        对于 j = 0; j < n - 1 - i; j = j + 1 {
            如果 文本.比较(行[j], 行[j + 1]) > 0 {
                变量 t = 行[j]
                行[j] = 行[j + 1]
                行[j + 1] = t
            }
        }
    }
    返回 连接(行, "\n")
}

// ==================== 数字 / 结构 ====================

// 千分位 数字加千分位分隔符：1234567 → "1,234,567"
函数 千分位(n) {
    变量 s = 文本.转文本(n)
    变量 负 = 假
    如果 文本.前缀(s, "-") {
        负 = 真
        s = 文本.去前缀(s, "-")
    }
    变量 反 = 文本.反转(s)
    变量 结果 = ""
    对于 i = 0; i < 长度(反); i = i + 1 {
        如果 i > 0 并且 i % 3 == 0 {
            结果 = 结果 + ","
        }
        结果 = 结果 + 文本.取字符(反, i)
    }
    结果 = 文本.反转(结果)
    如果 负 {
        返回 "-" + 结果
    }
    返回 结果
}

// 分割对 把 "a=1,b=2" 解析为 {"a": "1", "b": "2"}
函数 分割对(s, 项分隔, 键值分隔) {
    变量 结果 = {}
    变量 项 = 文本.分割(s, 项分隔)
    对于 i = 0; i < 长度(项); i = i + 1 {
        变量 对 = 文本.位置分割(项[i], 键值分隔)
        如果 对[1] == 键值分隔 {
            结果[文本.去空白(对[0])] = 文本.去空白(对[2])
        }
    }
    返回 结果
}

// 词频 统计词频，返回 {词: 次数}
函数 词频(s) {
    变量 词 = 文本.分词(s)
    变量 频 = {}
    对于 i = 0; i < 长度(词); i = i + 1 {
        变量 w = 词[i]
        如果 取值(频, w, 空) == 空 {
            频[w] = 1
        } 否则 {
            频[w] = 频[w] + 1
        }
    }
    返回 频
}

// 重复到宽度 把字符串重复填充到指定显示宽度（超宽则截断）
函数 重复到宽度(s, 宽) {
    如果 长度(s) == 0 {
        返回 ""
    }
    变量 结果 = ""
    当 文本.显示宽度(结果) < 宽 {
        结果 = 结果 + s
    }
    返回 文本.按宽度截断(结果, 宽, "")
}

// 版本 库版本
变量 版本 = "1.0.0"
