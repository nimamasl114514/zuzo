// collections — Zuzo 集合工具库 (单文件版)
// 提供栈、队列、数学工具等常用数据结构与算法
//
// 使用方式:
//   导入 "collections.z" 为 集合
//   变量 s = 集合.新建栈()
//   集合.栈压入(s, 1)
//   打印(集合.栈弹出(s))

// ==================== 栈 (Stack LIFO) ====================

// 新建栈 创建一个空栈
函数 新建栈() {
    返回 {"数据": [], "大小": 0}
}

// 栈压入 将元素压入栈顶
函数 栈压入(栈, 元素) {
    推入(栈["数据"], 元素)
    栈["大小"] = 栈["大小"] + 1
}

// 栈弹出 弹出并返回栈顶元素
函数 栈弹出(栈) {
    如果 栈["大小"] <= 0 {
        返回 空
    }
    变量 元素 = 弹出(栈["数据"])
    栈["大小"] = 栈["大小"] - 1
    返回 元素
}

// 栈查看 查看栈顶元素但不弹出
函数 栈查看(栈) {
    如果 栈["大小"] <= 0 {
        返回 空
    }
    返回 末项(栈["数据"])
}

// 栈是否为空 检查栈是否为空
函数 栈是否为空(栈) {
    返回 栈["大小"] == 0
}

// 栈清空 清除栈中所有元素
函数 栈清空(栈) {
    栈["数据"] = []
    栈["大小"] = 0
}

// ==================== 队列 (Queue FIFO) ====================

// 新建队列 创建一个空队列
函数 新建队列() {
    返回 {"数据": [], "大小": 0}
}

// 入队 将元素添加到队尾
函数 入队(队列, 元素) {
    推入(队列["数据"], 元素)
    队列["大小"] = 队列["大小"] + 1
}

// 出队 取出并返回队首元素
函数 出队(队列) {
    如果 队列["大小"] <= 0 {
        返回 空
    }
    变量 数组 = 队列["数据"]
    变量 元素 = 首项(数组)
    // 构建新数组（去掉第一个元素）
    变量 新数组 = []
    对于 i = 1; i < 队列["大小"]; i = i + 1 {
        推入(新数组, 数组[i])
    }
    队列["数据"] = 新数组
    队列["大小"] = 队列["大小"] - 1
    返回 元素
}

// 队列查看 查看队首元素但不取出
函数 队列查看(队列) {
    如果 队列["大小"] <= 0 {
        返回 空
    }
    返回 首项(队列["数据"])
}

// 队列是否为空 检查队列是否为空
函数 队列是否为空(队列) {
    返回 队列["大小"] == 0
}

// 队列清空 清除队列中所有元素
函数 队列清空(队列) {
    队列["数据"] = []
    队列["大小"] = 0
}

// ==================== 数学工具 ====================

// 最大值 返回数组中的最大值
函数 最大值(数组) {
    如果 长度(数组) == 0 {
        返回 空
    }
    变量 结果 = 数组[0]
    对于 i = 1; i < 长度(数组); i = i + 1 {
        如果 数组[i] > 结果 {
            结果 = 数组[i]
        }
    }
    返回 结果
}

// 最小值 返回数组中的最小值
函数 最小值(数组) {
    如果 长度(数组) == 0 {
        返回 空
    }
    变量 结果 = 数组[0]
    对于 i = 1; i < 长度(数组); i = i + 1 {
        如果 数组[i] < 结果 {
            结果 = 数组[i]
        }
    }
    返回 结果
}

// 求和 计算数组所有元素的和
函数 求和(数组) {
    变量 总和 = 0
    对于 i = 0; i < 长度(数组); i = i + 1 {
        总和 = 总和 + 数组[i]
    }
    返回 总和
}

// 平均值 计算数组的平均值
函数 平均值(数组) {
    如果 长度(数组) == 0 {
        返回 0
    }
    返回 求和(数组) / 长度(数组)
}

// 阶乘 计算 n 的阶乘 (n!)
函数 阶乘(n) {
    如果 n <= 1 {
        返回 1
    }
    返回 n * 阶乘(n - 1)
}

// 是否为素数 判断一个数是否为素数
函数 是否为素数(n) {
    如果 n < 2 {
        返回 假
    }
    如果 n == 2 {
        返回 真
    }
    如果 n % 2 == 0 {
        返回 假
    }
    变量 i = 3
    当 i * i <= n {
        如果 n % i == 0 {
            返回 假
        }
        i = i + 2
    }
    返回 真
}

// 生成素数 生成小于 n 的所有素数
函数 生成素数(n) {
    变量 素数列表 = []
    对于 i = 2; i < n; i = i + 1 {
        如果 是否为素数(i) {
            推入(素数列表, i)
        }
    }
    返回 素数列表
}

// 范围 生成从 start 到 end-1 的整数数组
函数 范围(起始, 结束) {
    变量 结果 = []
    对于 i = 起始; i < 结束; i = i + 1 {
        推入(结果, i)
    }
    返回 结果
}

// ==================== 模块信息 ====================

变量 版本 = "1.0.0"
变量 名称 = "collections"
