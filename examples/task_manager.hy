// ============================================================
// zuzo 迷你任务管理系统
// 展示：数据建模 · 闭包 · 文件持久化 · 错误处理 · 现代迭代器
// 运行方式: zuzo examples/task_manager.hy
// ============================================================

// ==================== 数据模型 ====================

定义 任务 {
    标题 = "未命名"
    优先级 = "普通"      // 紧急 / 高 / 普通 / 低
    状态 = "待办"         // 待办 / 进行中 / 完成
    创建时间 = 0
}

// ==================== 全局状态 ====================

变量 任务列表 = []
变量 数据文件 = "tasks_data.txt"
变量 下一个ID = 1

// ==================== 核心功能 ====================

// 添加新任务
函数 添加任务(标题, 优先级) {
    变量 t = 任务(标题: 标题, 优先级: 优先级, 创建时间: 时间戳())
    t["id"] = 下一个ID
    推入(任务列表, t)
    下一个ID = 下一个ID + 1
    打印(f"  [+] 已添加: #{t["id"]} {标题} (优先级: {优先级})")
    返回 t
}

// 列出所有任务（可按状态过滤）
函数 列出任务(过滤状态) {
    打印(f"\n{重复("─", 50)}")
    如果 长度(过滤状态) > 0 {
        打印(f"  任务列表 (筛选: {过滤状态})")
    } 否则 {
        打印("  任务列表 (全部)")
    }
    打印(f"{重复("─", 50)}")

    变量 计数 = 0
    对于 _, t 在 任务列表 {
        // 如果指定了过滤状态，跳过不匹配的
        如果 长度(过滤状态) > 0 并且 t["状态"] != 过滤状态 {
            跳过
        }

        变量 标记 = "○"
        如果 t["状态"] == "完成" {
            标记 = "✓"
        }
        如果 t["状态"] == "进行中" {
            标记 = "◐"
        }

        打印(f"  {标记} #{t["id"]} [{t["优先级"]}] {t["标题"]}")
        打印(f"      状态: {t["状态"]}")
        计数 = 计数 + 1
    }

    如果 计数 == 0 {
        打印("  (空空如也)")
    }
    打印(f"{重复("─", 50)}")
    打印(f"  共 {计数} 条任务\n")
}

// 标记任务状态
函数 更新状态(任务ID, 新状态) {
    对于 _, t 在 任务列表 {
        如果 t["id"] == 任务ID {
            t["状态"] = 新状态
            打印(f"  [→] #{任务ID} 状态变更为: {新状态}")
            返回 真
        }
    }
    打印(f"  [!] 未找到任务 #{任务ID}")
    返回 假
}

// 删除任务
函数 删除任务(任务ID) {
    变量 新列表 = []
    变量 已删除 = 假
    对于 _, t 在 任务列表 {
        如果 t["id"] == 任务ID {
            已删除 = 真
            打印(f"  [×] 已删除: #{任务ID} {t["标题"]}")
        } 否则 {
            推入(新列表, t)
        }
    }
    任务列表 = 新列表
    如果 非 已删除 {
        打印(f"  [!] 未找到任务 #{任务ID}")
    }
    返回 已删除
}

// 统计报告
函数 统计报告() {
    变量 待办数 = 0
    变量 进行中数 = 0
    变量 完成数 = 0
    变量 紧急数 = 0

    对于 _, t 在 任务列表 {
        如果 t["状态"] == "待办" {
            待办数 = 待办数 + 1
        }
        如果 t["状态"] == "进行中" {
            进行中数 = 进行中数 + 1
        }
        如果 t["状态"] == "完成" {
            完成数 = 完成数 + 1
        }
        如果 t["优先级"] == "紧急" {
            紧急数 = 紧急数 + 1
        }
    }

    变量 总数 = 长度(任务列表)
    变量 完成率 = 0
    如果 总数 > 0 {
        完成率 = 格式化(完成数 * 100 / 总数, 1)
    }

    打印("\n╔══════════════════════════════════════╗")
    打印("║        📊 任务统计报告              ║")
    打印("╠══════════════════════════════════════╣")
    打印(f"║  总任务数:   {总数}")
    打印(f"║  待办:       {待办数}")
    打印(f"║  进行中:     {进行中数}")
    打印(f"║  已完成:     {完成数}")
    打印(f"║  紧急任务:   {紧急数}")
    打印(f"║  完成率:     {完成率}%")
    打印("╚══════════════════════════════════════╝")
}

// ==================== 持久化：保存到文件 ====================

函数 保存数据() {
    变量 内容 = ""
    对于 _, t 在 任务列表 {
        内容 = f"{内容}{t["id"]}|{t["标题"]}|{t["优先级"]}|{t["状态"]}|{t["创建时间"]}\n"
    }
    写文件(数据文件, 内容)
    打印(f"  [💾] 已保存 {长度(任务列表)} 条任务到 {数据文件}")
}

// ==================== 持久化：从文件加载 ====================

函数 加载数据() {
    执行 {
        如果 非 文件存在(数据文件) {
            打印("  [ℹ] 无历史数据文件，从零开始")
            返回 空
        }

        变量 内容 = 读文件(数据文件)
        变量 行数组 = 分割(内容, "\n")
        变量 加载计数 = 0
        变量 最大ID = 0

        对于 _, 行 在 行数组 {
            如果 长度(去空白(行)) == 0 {
                跳过
            }

            变量 字段 = 分割(行, "|")
            如果 长度(字段) >= 5 {
                变量 t = 任务(
                    标题: 字段[1],
                    优先级: 字段[2],
                    状态: 字段[3],
                    创建时间: 整数(字段[4])
                )
                t["id"] = 整数(字段[0])
                推入(任务列表, t)
                加载计数 = 加载计数 + 1

                如果 t["id"] > 最大ID {
                    最大ID = t["id"]
                }
            }
        }

        下一个ID = 最大ID + 1
        打印(f"  [📂] 已加载 {加载计数} 条历史任务")
    } 遇到 err {
        打印(f"  [!] 加载数据时出错: {err}")
    }
}

// ==================== 搜索任务 ====================

函数 搜索任务(关键词) {
    变量 结果 = []
    变量 关键词小写 = 小写(关键词)

    对于 _, t 在 任务列表 {
        如果 包含(小写(t["标题"]), 关键词小写) {
            推入(结果, t)
        }
    }

    打印(f"\n  搜索 '{关键词}' 找到 {长度(结果)} 条结果:")
    对于 _, t 在 结果 {
        打印(f"    #{t["id"]} [{t["优先级"]}] {t["标题"]} — {t["状态"]}")
    }
    返回 结果
}

// ==================== 优先级排序 ====================

函数 按优先级排序() {
    变量 优先级权重 = {"紧急": 0, "高": 1, "普通": 2, "低": 3}

    // 简单选择排序
    变量 n = 长度(任务列表)
    对于 i = 0; i < n - 1; i = i + 1 {
        变量 最小索引 = i
        对于 j = i + 1; j < n; j = j + 1 {
            变量 权重J = 优先级权重[任务列表[j]["优先级"]]
            变量 权重Min = 优先级权重[任务列表[最小索引]["优先级"]]
            如果 权重J < 权重Min {
                最小索引 = j
            }
        }
        如果 最小索引 != i {
            变量 临时 = 任务列表[i]
            任务列表[i] = 任务列表[最小索引]
            任务列表[最小索引] = 临时
        }
    }

    打印("  [↕] 已按优先级排序")
}

// ==================== 主程序 ====================

打印("╔══════════════════════════════════════╗")
打印("║     🗂️  zuzo 迷你任务管理系统       ║")
打印("╚══════════════════════════════════════╝\n")

// 加载历史数据
加载数据()

// 添加一批任务
打印("\n--- 添加任务 ---")
添加任务("完成 zuzo SAP 优化文档", "高")
添加任务("修复 Environment 脑裂 Bug", "紧急")
添加任务("编写拓扑指纹测试用例", "普通")
添加任务("准备周会演示 slides", "高")
添加任务("整理 bench 基准测试数据", "低")
添加任务("审阅 PR #42", "普通")

// 列出全部
列出任务("")

// 启动几个任务
打印("\n--- 更新状态 ---")
更新状态(1, "进行中")
更新状态(2, "进行中")
更新状态(3, "完成")

// 完成一个任务
更新状态(1, "完成")

// 按状态过滤
列出任务("待办")
列出任务("进行中")
列出任务("完成")

// 搜索
打印("\n--- 搜索任务 ---")
搜索任务("zuzo")
搜索任务("测试")

// 排序
打印("\n--- 优先级排序 ---")
按优先级排序()
列出任务("")

// 统计
统计报告()

// 保存
打印("\n--- 持久化 ---")
保存数据()

// 验证：重新加载
打印("\n--- 验证持久化 ---")
任务列表 = []
下一个ID = 1
加载数据()
列出任务("")

打印("\n╔══════════════════════════════════════╗")
打印("║  ✓ 任务管理系统演示完成！           ║")
打印("╚══════════════════════════════════════╝")
