// zuzo 示例: 冒泡排序

函数 冒泡排序(数组) {
    变量 n = 长度(数组)
    对于 i = 0; i < n - 1; i = i + 1 {
        对于 j = 0; j < n - 1 - i; j = j + 1 {
            如果 数组[j] > 数组[j + 1] {
                变量 临时 = 数组[j]
                数组[j] = 数组[j + 1]
                数组[j + 1] = 临时
            }
        }
    }
    返回 数组
}

// 测试数据
变量 数据 = [64, 34, 25, 12, 22, 11, 90, 5, 77, 3]

打印("排序前:", 连接(数据, ", "))

变量 排序后 = 冒泡排序(数据)

打印("排序后:", 连接(排序后, ", "))

// 查找最大值和最小值
变量 最大 = 排序后[0]
变量 最小 = 排序后[0]

对于 i = 1; i < 长度(排序后); i = i + 1 {
    如果 排序后[i] > 最大 {
        最大 = 排序后[i]
    }
    如果 排序后[i] < 最小 {
        最小 = 排序后[i]
    }
}

打印("最大值:", 最大)
打印("最小值:", 最小)

// 哈希表示例
变量 成绩 = {
    "张三": 95,
    "李四": 87,
    "王五": 92,
    "赵六": 88
}

打印("\n成绩单:")
打印("张三:", 成绩["张三"])
打印("李四:", 成绩["李四"])
打印("王五:", 成绩["王五"])
打印("赵六:", 成绩["赵六"])

// 逻辑运算示例
变量 分数 = 85
如果 分数 >= 90 并且 分数 <= 100 {
    打印("\n优秀")
} 否则 如果 分数 >= 80 {
    打印("\n良好")
} 否则 如果 分数 >= 60 {
    打印("\n及格")
} 否则 {
    打印("\n不及格")
}

// 闭包示例
函数 计数器() {
    变量 count = 0
    函数 递增() {
        count = count + 1
        返回 count
    }
    返回 递增
}

变量 c = 计数器()
打印("\n计数器:")
打印(c())
打印(c())
打印(c())
