// demo_cffi.hy — Zuzo C 库 FFI 示例
//
// 演示如何无缝调用 C 动态库中的函数
// 在 Windows 上加载 DLL，在 Linux/macOS 上加载 .so/.dylib

// ============================================================
// 方式一：类型安全模式（推荐） — 先声明签名，再调用
// ============================================================

// 加载 C 数学库 (Windows: "msvcrt.dll", Linux: "libm.so.6", macOS: "libm.dylib")
// 这里以 Windows 的 msvcrt.dll 为例
变量 lib = 加载C库("msvcrt.dll")
打印("已加载:", lib)

// 声明函数签名: lib.绑定(函数名, [参数类型...], 返回类型)
// sqrt(double) -> double
变量 sqrt_fn = lib.绑定("sqrt", ["double"], "double")
打印("sqrt 签名:", sqrt_fn.签名)

// 调用: 结果 = sqrt_fn(144.0) → 12.0
变量 结果 = C调用(sqrt_fn, 144.0)
打印("sqrt(144.0) =", 结果)

// abs(int) -> int
变量 abs_fn = lib.绑定("abs", ["int"], "int")
打印("abs(-42) =", C调用(abs_fn, -42))

// ceil(double) -> double
变量 ceil_fn = lib.绑定("ceil", ["double"], "double")
打印("ceil(3.14) =", C调用(ceil_fn, 3.14))

// floor(double) -> double
变量 floor_fn = lib.绑定("floor", ["double"], "double")
打印("floor(3.99) =", C调用(floor_fn, 3.99))

// pow(double, double) -> double
变量 pow_fn = lib.绑定("pow", ["double", "double"], "double")
打印("pow(2, 10) =", C调用(pow_fn, 2.0, 10.0))

// ============================================================
// 方式二：动态调用模式 — 直接点号调用，自动推断类型
// ============================================================

打印("\n--- 动态调用模式 ---")

// 直接调用：lib.函数名(参数...)
// 注意：动态模式默认以整数方式传递和返回，适合整数函数
// 对于浮点函数，请使用上面的类型安全模式
打印("abs(-100) =", lib.abs(-100))

// ============================================================
// 方式三：低级 API
// ============================================================

打印("\n--- 低级 API ---")

变量 lib2 = 加载C库("msvcrt.dll")
变量 fn = C函数声明(lib2, "abs", ["int"], "int")
打印("函数对象:", fn)
打印("abs(-999) =", C调用(fn, -999))

// ============================================================
// 字符串操作示例: strlen
// ============================================================

打印("\n--- 字符串函数 ---")

变量 strlen_fn = lib.绑定("strlen", ["string"], "ulong")
打印("strlen(\"Hello, C FFI!\") =", C调用(strlen_fn, "Hello, C FFI!"))
打印("strlen(\"你好，世界\") =", C调用(strlen_fn, "你好，世界"))

// ============================================================
// 查询符号地址（调试用）
// ============================================================

打印("\n--- 符号查询 ---")
打印("sqrt 地址:", lib.符号("sqrt"))
打印("abs 地址:", lib.符号("abs"))

// 关闭库
lib.关闭()
lib2.关闭()
打印("\n库已关闭")
