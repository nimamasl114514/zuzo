// demo_collections.hy — 演示导入并使用 collections.z 库
//
// 运行方式:
//   zuzo examples/demo_collections.hy

导入 "../libs/collections/collections-1.0.0.z" 为 集合

打印("═══════════════════════════════════════")
打印("  collections 库演示 (版本 " + 集合.版本 + ")")
打印("═══════════════════════════════════════")

// ============ 栈 (Stack) ============
打印("\n--- 栈 (Stack LIFO) ---")

变量 s = 集合.新建栈()
集合.栈压入(s, 10)
集合.栈压入(s, 20)
集合.栈压入(s, 30)
打印("压入: 10, 20, 30")
打印("栈大小:", s["大小"])
打印("栈顶:", 集合.栈查看(s))

打印("弹出:", 集合.栈弹出(s))
打印("弹出:", 集合.栈弹出(s))
打印("是否为空:", 集合.栈是否为空(s))
打印("栈大小:", s["大小"])

// ============ 队列 (Queue) ============
打印("\n--- 队列 (Queue FIFO) ---")

变量 q = 集合.新建队列()
集合.入队(q, "任务A")
集合.入队(q, "任务B")
集合.入队(q, "任务C")
打印("入队: 任务A, 任务B, 任务C")
打印("队列大小:", q["大小"])

打印("出队:", 集合.出队(q))
打印("出队:", 集合.出队(q))
打印("队首:", 集合.队列查看(q))
打印("队列大小:", q["大小"])

// ============ 数学工具 ============
打印("\n--- 数学工具 ---")

变量 数 = [3, 1, 4, 1, 5, 9, 2, 6]
打印("数组:", 连接(数, ", "))
打印("最大值:", 集合.最大值(数))
打印("最小值:", 集合.最小值(数))
打印("求和:", 集合.求和(数))
打印("平均值:", 集合.平均值(数))

打印("\n阶乘(5) =", 集合.阶乘(5))

变量 素数 = 集合.生成素数(50)
打印("50以内素数:", 连接(素数, ", "))

变量 范围数 = 集合.范围(0, 5)
打印("范围(0,5):", 连接(范围数, ", "))

打印("\n═══════════════════════════════════════")
打印("  ✓ 演示完成!")
打印("═══════════════════════════════════════")
