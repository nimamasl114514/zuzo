// 浏览器自动化示例 — 模拟登录流程
// 需要系统安装 Chrome/Chromium 浏览器

打印("=== 浏览器自动化示例 ===")

// 1. 打开浏览器（有头模式，方便观察）
打印("正在启动浏览器...")
变量 浏览器 = 打开浏览器(真)
打印("浏览器已启动")

// 2. 新建页面
变量 页面 = 打开页面(浏览器)

// 3. 设置视口
设置视口(页面, 1280, 800)

// 4. 导航到示例网站
打印("正在导航到 example.com...")
导航(页面, "https://example.com")

// 5. 等待页面加载
等待元素(页面, "h1", 10000)

// 6. 获取页面标题
变量 标题 = 页面标题(页面)
打印(f"页面标题: {标题}")

// 7. 获取当前 URL
变量 网址 = 当前网址(页面)
打印(f"当前网址: {网址}")

// 8. 获取标题文本
变量 文本 = 获取文本(页面, "h1")
打印(f"标题文本: {文本}")

// 9. 获取页面全部文本
变量 全文 = 获取全部文本(页面)
打印(f"页面全文: {全文}")

// 10. 执行 JavaScript
变量 js结果 = 执行脚本(页面, "document.title")
打印(f"JS执行结果: {js结果}")

// 11. 截图
打印("正在截图...")
截图(页面, "example_screenshot.png")
打印("截图已保存到 example_screenshot.png")

// 12. 关闭浏览器
打印("关闭浏览器...")
关闭浏览器(浏览器)

打印("=== 示例完成 ===")
