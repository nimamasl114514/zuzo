// mixed_demo.hypy — zuzo + Python 混合示例：小型销售数据分析
// 运行： zuzo examples/mixed_demo.hypy
##PY
import json

def 解析(原始):
    """把 JSON 文本解析成 Python 字典列表"""
    return json.loads(原始)

def 汇总(记录):
    """返回各品类销售额与统计量"""
    by_cat = {}
    for r in 记录:
        by_cat[r["品类"]] = by_cat.get(r["品类"], 0) + r["金额"]
    return by_cat

def 中位数(记录):
    金额 = sorted([r["金额"] for r in 记录])
    n = len(金额)
    return 金额[n // 2] if n % 2 else (金额[n // 2 - 1] + 金额[n // 2]) / 2
##ZUZO
变量 原始 = "[{\"品类\": \"键盘\", \"金额\": 299}, {\"品类\": \"鼠标\", \"金额\": 139}, {\"品类\": \"键盘\", \"金额\": 459}, {\"品类\": \"显示器\", \"金额\": 1299}]"

变量 记录 = py调用("解析", 原始)
打印("记录条数 =", 长度(记录))

变量 汇总表 = py调用("汇总", 记录)
打印("按品类汇总 =", 汇总表)
打印("金额中位数 =", py调用("中位数", 记录))

// 用 zuzo 侧逻辑做排序输出
变量 品类们 = ["键盘", "鼠标", "显示器"]
对于 i = 0; i < 长度(品类们); i = i + 1 {
  变量 名 = 品类们[i]
  变量 额 = 汇总表[名]
  如果 额 > 300 {
    打印(f"  {名}: {额} 元（重点品类）")
  } 否则 {
    打印(f"  {名}: {额} 元")
  }
}

// Python 侧调用 zuzo 的函数
##PY
def 打印标题(t):
    print("=" * 20, t, "=" * 20)
##ZUZO
py调用("打印标题", "分析完成")
