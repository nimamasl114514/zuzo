// 浏览器自动化 — 最简测试
打印("=== 浏览器测试 ===")

变量 浏览器 = 打开浏览器(真)
打印("浏览器已启动")

变量 页面 = 打开页面(浏览器)
打印("页面已创建")

导航(页面, "https://example.com")
打印("导航完成")

等待(3000)
打印("等待3秒完成")

变量 标题 = 页面标题(页面)
打印(f"页面标题: {标题}")

变量 网址 = 当前网址(页面)
打印(f"当前网址: {网址}")

变量 js结果 = 执行脚本(页面, "document.querySelector('h1').textContent")
打印(f"H1文本(JS): {js结果}")

截图(页面, "test_screenshot.png")
打印("截图已保存")

关闭浏览器(浏览器)
打印("=== 测试完成 ===")
