// 浏览器自动化 — 模拟注册流程
// 展示如何用 zuzo 实现类似 Playwright 的自动化脚本
// 需要系统安装 Chrome/Chromium

打印("=== 自动注册流程模拟 ===")

// 生成随机用户信息
变量 用户名 = f"user_{随机整数(10000, 99999)}"
变量 邮箱 = f"{用户名}@example.com"
变量 密码 = f"Pass{随机整数(1000, 9999)}!"

打印("生成的用户信息:")
打印(f"  用户名: {用户名}")
打印(f"  邮箱: {邮箱}")
打印(f"  密码: {密码}")

// 1. 启动浏览器（无头模式）
打印("启动无头浏览器...")
变量 浏览器 = 打开浏览器(真)

// 2. 打开页面
变量 页面 = 打开页面(浏览器)
设置视口(页面, 1280, 800)

// 3. 导航到注册页面
打印("导航到注册页面...")
导航(页面, "https://example.com/register")

// 4. 等待表单加载
等待元素(页面, "#username", 15000)

// 5. 填写注册表单
打印("填写注册表单...")
填写(页面, "#username", 用户名)
填写(页面, "#email", 邮箱)
填写(页面, "#password", 密码)
填写(页面, "#confirm_password", 密码)

// 6. 勾选同意条款
打印("勾选同意条款...")
点击(页面, "#agree_terms")

// 7. 点击注册按钮
打印("点击注册按钮...")
点击(页面, "#submit_btn")

// 8. 等待跳转到成功页面
打印("等待注册完成...")
变量 成功 = 等待跳转(页面, "/success", 30000)

如果 成功 {
    打印("注册成功！")
    
    // 获取成功消息
    变量 消息 = 获取文本(页面, ".success-message")
    打印(f"成功消息: {消息}")
    
    // 截图保存证据
    截图(页面, "register_success.png")
    打印("截图已保存")
} 否则 {
    打印("注册超时或失败")
    截图(页面, "register_failed.png")
    打印("失败截图已保存")
    
    // 获取错误信息
    变量 错误文本 = 获取文本(页面, ".error-message")
    打印(f"错误信息: {错误文本}")
}

// 9. 关闭浏览器
关闭浏览器(浏览器)
打印("=== 流程结束 ===")
