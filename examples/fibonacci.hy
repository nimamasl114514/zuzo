// zuzo 示例: 斐波那契数列

// 递归实现
函数 斐波那契(n) {
    如果 n <= 1 {
        返回 n
    }
    返回 斐波那契(n - 1) + 斐波那契(n - 2)
}

// 打印前 10 个斐波那契数
对于 i = 0; i < 10; i = i + 1 {
    打印(f"斐波那契({i}) =", 斐波那契(i))
}

// 迭代实现
变量 n = 15
变量 a = 0
变量 b = 1
变量 结果 = []

对于 i = 0; i < n; i = i + 1 {
    推入(结果, a)
    变量 临时 = a + b
    a = b
    b = 临时
}

打印("前 15 个斐波那契数:", 连接(结果, ", "))
