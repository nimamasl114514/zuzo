// ============================================================
// Zuzo 多线程并发示例
// 并发() · 通道() · 发送() · 接收() · 等待全部()
// ============================================================

打印("═══════════════════════════════════════")
打印("  一、并发计算：多任务并行求和")
打印("═══════════════════════════════════════")

// 启动 3 个并发任务，分别计算不同范围的累加和
变量 任务1 = 并发(函数() {
    变量 s = 0
    对于 i 在 1 到 1000000 {
        s = s + i
    }
    返回 s
})

变量 任务2 = 并发(函数() {
    变量 s = 0
    对于 i 在 1000001 到 2000000 {
        s = s + i
    }
    返回 s
})

变量 任务3 = 并发(函数() {
    变量 s = 0
    对于 i 在 2000001 到 3000000 {
        s = s + i
    }
    返回 s
})

// 等待全部完成，按顺序返回结果
变量 t0 = 时间戳()
变量 结果们 = 等待全部(任务1, 任务2, 任务3)
变量 t1 = 时间戳()

打印(f"  任务1 (1~1000000):      {结果们[0]}")
打印(f"  任务2 (1000001~2000000): {结果们[1]}")
打印(f"  任务3 (2000001~3000000): {结果们[2]}")
打印(f"  总和: {结果们[0] + 结果们[1] + 结果们[2]}")
打印(f"  并发耗时: {t1 - t0}ms")

// 对比串行执行同样计算
t0 = 时间戳()
变量 s1 = 0
对于 i 在 1 到 3000000 {
    s1 = s1 + i
}
t1 = 时间戳()
打印(f"  串行验证: {s1}")
打印(f"  串行耗时: {t1 - t0}ms")


打印("\n═══════════════════════════════════════")
打印("  二、生产者-消费者模型")
打印("═══════════════════════════════════════")

// 有缓冲通道：生产者快速生产，消费者慢慢处理
变量 队列 = 通道(5)

// 生产者：往通道塞 5 条消息
并发(函数() {
    对于 i 在 1 到 5 {
        发送(队列, f"消息#{i}")
        打印(f"  [生产] 已发送 消息#{i}")
        睡眠(50)
    }
    关闭(队列)
})

// 消费者：从通道逐条接收（阻塞式，通道关闭后接收返回空）
变量 消费计数 = 0
变量 消费中 = 真
当 消费中 {
    变量 msg = 接收(队列)
    如果 msg == 空 {
        消费中 = 假
    } 否则 {
        消费计数 = 消费计数 + 1
        打印(f"  [消费] 收到 {msg}")
        睡眠(100)
    }
}

打印(f"  共消费 {消费计数} 条消息")


打印("\n═══════════════════════════════════════")
打印("  三、Fan-Out 模式：多 Worker 并行处理")
打印("═══════════════════════════════════════")

// 创建 4 个 worker 并行处理数据
变量 数据 = [10, 20, 30, 40]
变量 worker通道们 = []

对于 i, val 在 数据 {
    变量 v = val
    变量 idx = i
    推入(worker通道们, 并发(函数() {
        睡眠(100)  // 模拟耗时计算
        返回 f"worker{idx}: {v}² = {v * v}"
    }))
}

// 收集结果（顺序与启动顺序一致）
变量 完成结果 = 等待全部(worker通道们[0], worker通道们[1], worker通道们[2], worker通道们[3])
对于 _, r 在 完成结果 {
    打印(f"  {r}")
}


打印("\n═══════════════════════════════════════")
打印("  四、并发流水线：阶段式处理")
打印("═══════════════════════════════════════")

// 阶段1：生成数据 → 阶段2：平方计算 → 阶段3：格式化输出
变量 输入 = [1, 2, 3, 4, 5]

// 阶段1+2 并行：每个数字的平方在独立 goroutine 中计算
变量 平方任务们 = []
对于 _, n 在 输入 {
    变量 x = n
    推入(平方任务们, 并发(函数() {
        睡眠(50)
        返回 x * x
    }))
}

// 等待全部平方完成
变量 平方结果们 = 等待全部(平方任务们[0], 平方任务们[1], 平方任务们[2], 平方任务们[3], 平方任务们[4])

// 阶段3：串行汇总
变量 汇总 = ""
对于 i, sq 在 平方结果们 {
    汇总 = 汇总 + f"{输入[i]}²={sq} "
}
打印(f"  平方流水线: {汇总}")
打印(f"  5个任务并发执行，总耗时仅约50ms而非250ms")


打印("\n═══════════════════════════════════════")
打印("  ✓ 多线程并发示例全部完成！")
打印("═══════════════════════════════════════")
