// ============================================================
// Zuzo 现代语言特性演示
// 数据建模 · 错误处理 · 现代迭代器 · 循环控制
// ============================================================

打印("═══════════════════════════════════════")
打印("  一、数据建模：定义 + 具名参数实例化")
打印("═══════════════════════════════════════")

定义 用户 {
    名称 = "匿名"
    年龄 = 0
    活跃 = 真
}

// 具名参数实例化，顺序无关，未指定则用默认值
变量 u1 = 用户(名称: "张三", 年龄: 25)
变量 u2 = 用户(年龄: 30, 名称: "李四", 活跃: 假)
变量 u3 = 用户(名称: "王五")

// 点号访问属性
打印(f"  {u1.名称}, {u1.年龄}岁, 活跃={u1.活跃}")
打印(f"  {u2.名称}, {u2.年龄}岁, 活跃={u2.活跃}")
打印(f"  {u3.名称}, {u3.年龄}岁, 活跃={u3.活跃}")

// 修改属性
u1.年龄 = 26
打印(f"  修改后: {u1.名称} {u1.年龄}岁")

// 索引访问也支持
打印(f"  索引访问: {u2["名称"]}")

打印("\n═══════════════════════════════════════")
打印("  二、错误处理：否则 fallback + 执行/遇到")
打印("═══════════════════════════════════════")

// 表达式级 fallback：读文件失败时用默认值
变量 配置 = 读文件("不存在的文件.json") 否则 "{\"theme\":\"dark\"}"
打印(f"  配置(文件不存在→fallback): {配置}")

// 正常时不触发 fallback
变量 结果 = 10 / 2 否则 0
打印(f"  正常运算(10/2): {结果}")

// 执行/遇到 块捕获
执行 {
    变量 x = 1
    变量 y = 0
    变量 z = x / y
    打印(f"  这行不会执行: {z}")
} 遇到 err {
    打印(f"  捕获到错误: {err}")
}

// 执行/遇到 无错误时正常执行
执行 {
    打印("  执行块正常执行，无错误")
} 遇到 err {
    打印(f"  这行不会执行: {err}")
}

打印("\n═══════════════════════════════════════")
打印("  三、现代迭代器")
打印("═══════════════════════════════════════")

// 区间遍历: 在 1 到 5
打印("  区间 1→5:")
对于 i 在 1 到 5 {
    打印(f"    i = {i}")
}

// 条件过滤: 满足
打印("  1→10 中的偶数:")
对于 i 在 1 到 10 满足 i % 2 == 0 {
    打印(f"    {i}")
}

// 数组遍历
变量 水果 = ["苹果", "香蕉", "橙子"]
打印("  水果列表:")
对于 f 在 水果 {
    打印(f"    - {f}")
}

// 带索引遍历: i, x
打印("  带索引遍历:")
对于 i, x 在 水果 {
    打印(f"    [{i}] {x}")
}

// 哈希遍历
变量 分数 = {"语文": 90, "数学": 85, "英语": 92}
打印("  哈希遍历:")
对于 科目, 分 在 分数 {
    打印(f"    {科目}: {分}")
}

// 跳过与跳出
打印("  1→10 中跳过3的倍数，遇到8跳出:")
对于 i 在 1 到 10 {
    如果 i == 8 {
        打印(f"    遇到 {i}，跳出！")
        跳出
    }
    如果 i % 3 == 0 {
        跳过
    }
    打印(f"    {i}")
}

打印("\n═══════════════════════════════════════")
打印("  四、综合示例：用户管理系统")
打印("═══════════════════════════════════════")

定义 学生 {
    姓名 = "未知"
    学号 = 0
    分数 = 0
}

变量 学生们 = [
    学生(姓名: "张三", 学号: 1, 分数: 95),
    学生(姓名: "李四", 学号: 2, 分数: 87),
    学生(姓名: "王五", 学号: 3, 分数: 92),
    学生(姓名: "赵六", 学号: 4, 分数: 78)
]

变量 总分 = 0
变量 优秀人数 = 0

对于 _, s 在 学生们 {
    打印(f"  {s.姓名}(学号{s.学号}): {s.分数}分")
    总分 = 总分 + s.分数
    如果 s.分数 >= 90 {
        优秀人数 = 优秀人数 + 1
    }
}

打印(f"\n  总分: {总分}")
打印(f"  平均分: {总分 / 长度(学生们)}")
打印(f"  优秀人数(≥90): {优秀人数}")

// 用 fallback 处理可能为空的查询
变量 查找结果 = 读文件("不存在的学生档案.txt") 否则 "档案不存在"
打印(f"  档案查询: {查找结果}")

打印("\n═══════════════════════════════════════")
打印("  ✓ 所有现代特性正常运行！")
打印("═══════════════════════════════════════")
