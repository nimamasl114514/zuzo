// ========================================
// zuzo BDD 测试框架示例
// 展示完整的 BDD 测试流程：
//   测试套件 → 测试用例 → 断言 → 运行测试
// ========================================

// ========== 套件 1：基础数据类型 ==========

测试套件("基础数据类型", 函数() {

    测试用例("整数运算", 函数() {
        断言相等(1 + 1, 2)
        断言相等(10 - 3, 7)
        断言相等(6 * 7, 42)
        断言相等(100 / 4, 25)
        断言相等(17 % 5, 2)
    })

    测试用例("浮点数运算", 函数() {
        断言相等(3.14 + 2.86, 6.0)
        断言大于(3.14, 3.0)
        断言小于(2.71, 3.14)
        断言大于等于(3.14, 3.14)
        断言小于等于(2.71, 3.14)
    })

    测试用例("布尔逻辑", 函数() {
        断言为真(真)
        断言为假(假)
        断言为真(1 < 2)
        断言为假(1 > 2)
        断言为真(真 并且 真)
        断言为真(真 或者 假)
    })

    测试用例("字符串操作", 函数() {
        变量 s = "hello zuzo"
        断言相等(长度(s), 10)
        断言包含(s, "zuzo")
        断言包含(s, "hello")
        断言相等(大写("abc"), "ABC")
        断言相等(小写("XYZ"), "xyz")
        断言相等(去空白("  hi  "), "hi")
    })

    测试用例("空值判断", 函数() {
        断言为空(空)
        变量 x = 42
        断言非空(x)
    })
})

// ========== 套件 2：数组操作 ==========

测试套件("数组操作", 函数() {
    变量 共享数组 = []

    测试前(函数() {
        共享数组 = [1, 2, 3]
    })

    测试后(函数() {
        // 清理
        共享数组 = []
    })

    测试用例("推入元素", 函数() {
        推入(共享数组, 4)
        断言相等(长度(共享数组), 4)
        断言相等(共享数组[3], 4)
    })

    测试用例("弹出元素", 函数() {
        变量 v = 弹出(共享数组)
        断言相等(v, 3)
        断言相等(长度(共享数组), 2)
    })

    测试用例("首项末项", 函数() {
        断言相等(首项(共享数组), 1)
        断言相等(末项(共享数组), 3)
    })

    测试用例("数组包含", 函数() {
        断言包含(共享数组, 2)
        断言包含(共享数组, 3)
    })

    测试用例("数组不相等", 函数() {
        断言不相等(共享数组, [1, 2, 3, 4])
        断言不相等(共享数组, [])
    })
})

// ========== 套件 3：哈希表操作 ==========

测试套件("哈希表操作", 函数() {

    测试用例("创建和访问", 函数() {
        变量 h = {"name": "zuzo", "version": 1}
        断言相等(h["name"], "zuzo")
        断言相等(h["version"], 1)
    })

    测试用例("哈希表创建", 函数() {
        变量 h = {"a": 1, "b": 2, "c": 3}
        断言相等(h["a"], 1)
        断言相等(h["b"], 2)
        断言相等(h["c"], 3)
    })

    测试用例("哈希表相等", 函数() {
        变量 h1 = {"x": 1, "y": 2}
        变量 h2 = {"x": 1, "y": 2}
        断言相等(h1, h2)
    })
})

// ========== 套件 4：函数与闭包 ==========

测试套件("函数与闭包", 函数() {

    测试用例("递归斐波那契", 函数() {
        函数 fib(n) {
            如果 n <= 1 { 返回 n }
            返回 fib(n - 1) + fib(n - 2)
        }
        断言相等(fib(0), 0)
        断言相等(fib(1), 1)
        断言相等(fib(10), 55)
    })

    测试用例("闭包计数器", 函数() {
        函数 计数器() {
            变量 n = 0
            返回 函数() {
                n = n + 1
                返回 n
            }
        }
        变量 c = 计数器()
        断言相等(c(), 1)
        断言相等(c(), 2)
        断言相等(c(), 3)
    })

    测试用例("高阶函数", 函数() {
        函数 apply(f, x) {
            返回 f(x)
        }
        断言相等(apply(函数(n) { 返回 n * 2 }, 21), 42)
    })
})

// ========== 套件 5：JSON 序列化 ==========

测试套件("JSON 序列化", 函数() {

    测试用例("解析 JSON 对象", 函数() {
        变量 data = json解析("{\"name\": \"zuzo\", \"age\": 1}")
        断言非空(data)
        断言相等(data["name"], "zuzo")
        断言相等(data["age"], 1)
    })

    测试用例("序列化为 JSON", 函数() {
        变量 obj = {"x": 42, "y": "hello"}
        变量 s = json序列化(obj)
        断言包含(s, "x")
        断言包含(s, "42")
        断言包含(s, "hello")
    })

    测试用例("JSON 往返", 函数() {
        变量 原始 = {"a": 1, "b": 2}
        变量 json字符串 = json序列化(原始)
        变量 解析后 = json解析(json字符串)
        断言相等(解析后["a"], 1)
        断言相等(解析后["b"], 2)
    })
})

// ========== 套件 6：条件与分支 ==========

测试套件("条件与分支", 函数() {

    测试用例("if-else 分支", 函数() {
        函数 等级(分数) {
            如果 分数 >= 90 { 返回 "优秀" }
            否则 如果 分数 >= 80 { 返回 "良好" }
            否则 如果 分数 >= 60 { 返回 "及格" }
            否则 { 返回 "不及格" }
        }
        断言相等(等级(95), "优秀")
        断言相等(等级(85), "良好")
        断言相等(等级(65), "及格")
        断言相等(等级(45), "不及格")
    })

    测试用例("while 循环", 函数() {
        变量 sum = 0
        变量 i = 1
        当 i <= 10 {
            sum = sum + i
            i = i + 1
        }
        断言相等(sum, 55)
    })

    测试用例("for 循环", 函数() {
        变量 product = 1
        对于 i = 1; i <= 5; i = i + 1 {
            product = product * i
        }
        断言相等(product, 120)
    })
})

// ========== 套件 7：f-string 插值 ==========

测试套件("f-string 插值", 函数() {

    测试用例("基础插值", 函数() {
        变量 name = "zuzo"
        变量 s = f"hello {name}"
        断言相等(s, "hello zuzo")
    })

    测试用例("表达式插值", 函数() {
        变量 a = 3
        变量 b = 4
        断言相等(f"{a} + {b} = {a + b}", "3 + 4 = 7")
    })

    测试用例("转义花括号", 函数() {
        断言相等(f"{{not var}}", "{not var}")
    })
})

// ========== 运行所有测试 ==========

变量 全部通过 = 运行测试()

如果 全部通过 {
    打印("\n所有测试通过！")
} 否则 {
    打印("\n存在失败的测试。")
}
