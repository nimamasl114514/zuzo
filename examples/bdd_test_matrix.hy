        断言为真(前缀(s, "20"))
    })

    测试用例("格式化时间", 函数() {
        变量 ts = 1704067200  // 2024-01-01 00:00:00 UTC
        变量 formatted = 格式化时间(ts, "2006-01-02")
        断言相等(前缀(formatted, "2024"), 真)
    })

