// ============================================================
// zuzo BDD 完整测试矩阵
// 覆盖全部功能模块：词法/语法/求值 + 数组 + 字符串 + 数学
//   + 时间 + JSON + 正则 + 并发 + 文件I/O + 网络 + f-string
//   + 闭包 + 控制流 + SAP + 边界/异常
// ============================================================

// ============================================================
// 套件 1：词法与字面量
// ============================================================
测试套件("词法与字面量", 函数() {

    测试用例("整数字面量", 函数() {
        断言相等(42, 42)
        断言相等(0, 0)
        断言相等(-1, -1)
        断言相等(1000000, 1000000)
        断言不相等(1, 2)
    })

    测试用例("浮点数字面量", 函数() {
        断言相等(3.14, 3.14)
        断言相等(0.0, 0.0)
        断言相等(-2.5, -2.5)
        断言不相等(3.14, 2.71)
    })

    测试用例("字符串字面量", 函数() {
        断言相等("hello", "hello")
        断言相等("", "")
        断言相等("中文测试", "中文测试")
        断言不相等("abc", "abd")
    })

    测试用例("布尔字面量", 函数() {
        断言为真(真)
        断言为假(假)
        断言不相等(真, 假)
    })

    测试用例("空值字面量", 函数() {
        断言为空(空)
        断言相等(空, 空)
    })

    测试用例("类型名", 函数() {
        断言相等(类型(42), "整数")
        断言相等(类型(3.14), "浮点数")
        断言相等(类型("hi"), "字符串")
        断言相等(类型(真), "布尔")
        断言相等(类型(空), "空")
        断言相等(类型([1, 2]), "数组")
    })

    测试用例("类型转换", 函数() {
        断言相等(字符串(42), "42")
        断言相等(字符串(3.14), "3.14")
        断言相等(字符串(真), "真")
        断言相等(整数("123"), 123)
        断言相等(整数(3.99), 3)
        断言相等(浮点数("3.14"), 3.14)
        断言相等(浮点数(42), 42.0)
    })
})

// ============================================================
// 套件 2：算术运算
// ============================================================
测试套件("算术运算", 函数() {

    测试用例("整数四则运算", 函数() {
        断言相等(7 + 3, 10)
        断言相等(7 - 3, 4)
        断言相等(7 * 3, 21)
        断言相等(20 / 4, 5)
        断言相等(17 % 5, 2)
    })

    测试用例("浮点数运算", 函数() {
        断言相等(1.5 + 2.5, 4.0)
        断言相等(5.0 - 1.5, 3.5)
        断言相等(2.5 * 4.0, 10.0)
        断言相等(10.0 / 4.0, 2.5)
    })

    测试用例("混合类型运算", 函数() {
        断言相等(3 + 0.14, 3.14)
        断言相等(10 - 2.5, 7.5)
        断言相等(2 * 3.5, 7.0)
        断言相等(9 / 2.0, 4.5)
    })

    测试用例("负数运算", 函数() {
        断言相等(-10, -10)
        断言相等(-(5 + 3), -8)
        断言相等((-5) * (-3), 15)
        断言相等(-2.5 + 2.5, 0.0)
    })

    测试用例("运算优先级", 函数() {
        断言相等(2 + 3 * 4, 14)
        断言相等((2 + 3) * 4, 20)
        断言相等(10 - 2 - 3, 5)
        断言相等(100 / 10 / 2, 5)
        断言相等(2 + 3 * 4 - 1, 13)
    })

    测试用例("比较运算", 函数() {
        断言为真(3 > 2)
        断言为真(2 < 3)
        断言为真(3 >= 3)
        断言为真(2 <= 2)
        断言为真(3 == 3)
        断言为真(3 != 4)
        断言为假(3 > 5)
        断言为假(3 < 1)
    })

    测试用例("浮点比较", 函数() {
        断言为真(3.14 > 3.0)
        断言为真(2.71 < 3.14)
        断言为真(3.14 >= 3.14)
        断言为真(2.71 <= 3.14)
    })

    测试用例("逻辑运算", 函数() {
        断言为真(真 并且 真)
        断言为假(真 并且 假)
        断言为真(真 或者 假)
        断言为假(假 或者 假)
        断言为真(非 假)
        断言为假(非 真)
    })

    测试用例("短路求值", 函数() {
        变量 called = 0
        函数 sideEffect() {
            called = called + 1
            返回 真
        }
        变量 r1 = 假 并且 sideEffect()
        断言相等(called, 0)

        变量 r2 = 真 或者 sideEffect()
        断言相等(called, 0)
    })
})

// ============================================================
// 套件 3：字符串处理
// ============================================================
测试套件("字符串处理", 函数() {

    测试用例("大小写转换", 函数() {
        断言相等(大写("hello"), "HELLO")
        断言相等(小写("WORLD"), "world")
        断言相等(大写("Hello World"), "HELLO WORLD")
        断言相等(小写("Hello World"), "hello world")
    })

    测试用例("前后缀检查", 函数() {
        断言为真(前缀("hello world", "hello"))
        断言为假(前缀("hello world", "world"))
        断言为真(后缀("hello world", "world"))
        断言为假(后缀("hello world", "hello"))
    })

    测试用例("查找与计数", 函数() {
        断言相等(查找("hello world", "world"), 6)
        断言相等(查找("hello world", "xyz"), -1)
        断言相等(计数("aaa", "a"), 3)
        断言相等(计数("ababab", "ab"), 3)
        断言相等(计数("hello", "l"), 2)
    })

    测试用例("替换", 函数() {
        断言相等(替换("hello world", "world", "zuzo"), "hello zuzo")
        断言相等(替换("aaa", "a", "b"), "bbb")
        断言相等(替换("abc", "x", "y"), "abc")
    })

    测试用例("分割与连接", 函数() {
        变量 parts = 分割("a,b,c", ",")
        断言相等(长度(parts), 3)
        断言相等(parts[0], "a")
        断言相等(parts[1], "b")
        断言相等(parts[2], "c")

        变量 joined = 连接([1, 2, 3], "-")
        断言相等(joined, "1-2-3")
    })

    测试用例("空白处理", 函数() {
        断言相等(去空白("  hi  "), "hi")
        断言相等(去空白("\t\nhi\r\n"), "hi")
        断言相等(裁剪("xxhiyy", "xy"), "hi")
        断言相等(去空白("无空白"), "无空白")
    })

    测试用例("重复", 函数() {
        断言相等(重复("ab", 3), "ababab")
        断言相等(重复("x", 0), "")
        断言相等(重复("", 5), "")
    })

    测试用例("分词", 函数() {
        变量 words = 分词("hello world foo bar")
        断言相等(长度(words), 4)
        断言相等(words[0], "hello")
        断言相等(words[3], "bar")

        变量 empty = 分词("   ")
        断言相等(长度(empty), 0)
    })

    测试用例("取字符", 函数() {
        断言相等(取字符("hello", 0), "h")
        断言相等(取字符("hello", 4), "o")
        断言相等(取字符("你好", 0), "你")
        断言相等(取字符("你好", 1), "好")
    })

    测试用例("字符串长度", 函数() {
        断言相等(长度("hello"), 5)
        断言相等(长度(""), 0)
        断言相等(长度("你好"), 2)
        断言相等(长度("a b c"), 5)
    })

    测试用例("字符串包含", 函数() {
        断言为真(包含("hello world", "world"))
        断言为假(包含("hello world", "xyz"))
        断言为真(包含("hello", ""))
    })

    测试用例("格式化-sprintf", 函数() {
        断言相等(格式化("%d", 42), "42")
        断言相等(格式化("%s", "hi"), "hi")
        断言相等(格式化("%d-%s", 42, "test"), "42-test")
    })

    测试用例("格式化-浮点数", 函数() {
        断言相等(格式化(3.14159, 2), "3.14")
        断言相等(格式化(3.14159, 0), "3")
        断言相等(格式化(100.0, 1), "100.0")
    })
})

// ============================================================
// 套件 4：数组操作
// ============================================================
测试套件("数组操作", 函数() {

    测试用例("数组创建与索引", 函数() {
        变量 arr = [10, 20, 30]
        断言相等(arr[0], 10)
        断言相等(arr[1], 20)
        断言相等(arr[2], 30)
        断言相等(长度(arr), 3)
    })

    测试用例("空数组", 函数() {
        变量 arr = []
        断言相等(长度(arr), 0)
        推入(arr, 1)
        断言相等(长度(arr), 1)
        断言相等(arr[0], 1)
    })

    测试用例("推入与弹出", 函数() {
        变量 arr = [1, 2]
        推入(arr, 3)
        断言相等(长度(arr), 3)
        断言相等(末项(arr), 3)

        变量 v = 弹出(arr)
        断言相等(v, 3)
        断言相等(长度(arr), 2)
    })

    测试用例("首项末项", 函数() {
        断言相等(首项([10, 20, 30]), 10)
        断言相等(末项([10, 20, 30]), 30)
    })

    测试用例("空数组首末项", 函数() {
        断言为空(首项([]))
        断言为空(末项([]))
    })

    测试用例("数组包含", 函数() {
        变量 arr = [1, 2, 3, "hello"]
        断言为真(包含(arr, 2))
        断言为真(包含(arr, "hello"))
        断言为假(包含(arr, 99))
    })

    测试用例("数组连接", 函数() {
        断言相等(连接([1, 2, 3], ","), "1,2,3")
        断言相等(连接(["a", "b", "c"], ""), "abc")
        断言相等(连接([1, 2, 3], " | "), "1 | 2 | 3")
    })

    测试用例("数组可变性", 函数() {
        变量 arr = [1, 2, 3]
        arr[1] = 99
        断言相等(arr[1], 99)
        断言相等(arr[0], 1)
        断言相等(arr[2], 3)
    })

    测试用例("嵌套数组", 函数() {
        变量 matrix = [[1, 2], [3, 4]]
        断言相等(matrix[0][0], 1)
        断言相等(matrix[0][1], 2)
        断言相等(matrix[1][0], 3)
        断言相等(matrix[1][1], 4)
    })

    测试用例("混合类型数组", 函数() {
        变量 arr = [1, "two", 3.0, 真, 空]
        断言相等(arr[0], 1)
        断言相等(arr[1], "two")
        断言相等(arr[2], 3.0)
        断言为真(arr[3])
        断言为空(arr[4])
    })

    测试用例("数组深度相等", 函数() {
        断言相等([1, 2, 3], [1, 2, 3])
        断言不相等([1, 2, 3], [1, 2, 4])
        断言不相等([1, 2, 3], [1, 2])
        断言相等([[1, 2], [3, 4]], [[1, 2], [3, 4]])
    })
})

// ============================================================
// 套件 5：哈希表操作
// ============================================================
测试套件("哈希表操作", 函数() {

    测试用例("创建与访问", 函数() {
        变量 h = {"name": "zuzo", "version": 1, "active": 真}
        断言相等(h["name"], "zuzo")
        断言相等(h["version"], 1)
        断言为真(h["active"])
    })

    测试用例("修改值", 函数() {
        变量 h = {"x": 1}
        h["x"] = 99
        断言相等(h["x"], 99)

        h["new"] = "added"
        断言相等(h["new"], "added")
    })

    测试用例("不同键类型", 函数() {
        变量 h = {"str": "a", 42: "b", 真: "c"}
        断言相等(h["str"], "a")
        断言相等(h[42], "b")
        断言相等(h[真], "c")
    })

    测试用例("哈希表深度相等", 函数() {
        断言相等({"a": 1, "b": 2}, {"a": 1, "b": 2})
        断言不相等({"a": 1}, {"a": 2})
        断言不相等({"a": 1, "b": 2}, {"a": 1})
    })

    测试用例("嵌套哈希", 函数() {
        变量 h = {"outer": {"inner": 42}}
        变量 inner = h["outer"]
        断言相等(inner["inner"], 42)
    })

    测试用例("空哈希表", 函数() {
        变量 h = {}
        断言相等(h, {})
    })
})

// ============================================================
// 套件 6：控制流
// ============================================================
测试套件("控制流", 函数() {

    测试用例("if 分支", 函数() {
        函数 check(n) {
            如果 n > 0 { 返回 "正" }
            否则 如果 n < 0 { 返回 "负" }
            否则 { 返回 "零" }
        }
        断言相等(check(42), "正")
        断言相等(check(-1), "负")
        断言相等(check(0), "零")
    })

    测试用例("if 表达式求值", 函数() {
        变量 x = 10
        变量 label = 如果 x > 5 { "大" } 否则 { "小" }
        断言相等(label, "大")

        变量 y = 3
        变量 label2 = 如果 y > 5 { "大" } 否则 { "小" }
        断言相等(label2, "小")
    })

    测试用例("while 循环", 函数() {
        变量 sum = 0
        变量 i = 1
        当 i <= 100 {
            sum = sum + i
            i = i + 1
        }
        断言相等(sum, 5050)
    })

    测试用例("while 条件不满足", 函数() {
        变量 ran = 0
        当 假 { ran = ran + 1 }
        断言相等(ran, 0)
    })

    测试用例("for 循环", 函数() {
        变量 product = 1
        对于 i = 1; i <= 5; i = i + 1 {
            product = product * i
        }
        断言相等(product, 120)
    })

    测试用例("for 循环累加", 函数() {
        变量 total = 0
        对于 i = 0; i < 10; i = i + 1 {
            total = total + i
        }
        断言相等(total, 45)
    })

    测试用例("嵌套循环", 函数() {
        变量 count = 0
        对于 i = 0; i < 3; i = i + 1 {
            对于 j = 0; j < 3; j = j + 1 {
                count = count + 1
            }
        }
        断言相等(count, 9)
    })

    测试用例("return 提前退出", 函数() {
        函数 find(arr, target) {
            变量 i = 0
            当 i < 长度(arr) {
                如果 arr[i] == target {
                    返回 i
                }
                i = i + 1
            }
            返回 -1
        }
        断言相等(find([10, 20, 30], 20), 1)
        断言相等(find([10, 20, 30], 99), -1)
    })

    测试用例("break via return in nested", 函数() {
        函数 search(matrix, target) {
            对于 i = 0; i < 长度(matrix); i = i + 1 {
                对于 j = 0; j < 长度(matrix[i]); j = j + 1 {
                    如果 matrix[i][j] == target {
                        返回 [i, j]
                    }
                }
            }
            返回 空
        }
        变量 pos = search([[1, 2], [3, 4]], 3)
        断言非空(pos)
        断言相等(pos[0], 1)
        断言相等(pos[1], 0)
    })
})

// ============================================================
// 套件 7：函数与闭包
// ============================================================
测试套件("函数与闭包", 函数() {

    测试用例("基本函数", 函数() {
        函数 add(a, b) { 返回 a + b }
        断言相等(add(3, 4), 7)
        断言相等(add(0, 0), 0)
        断言相等(add(-1, 1), 0)
    })

    测试用例("递归", 函数() {
        函数 fact(n) {
            如果 n <= 1 { 返回 1 }
            返回 n * fact(n - 1)
        }
        断言相等(fact(0), 1)
        断言相等(fact(1), 1)
        断言相等(fact(5), 120)
        断言相等(fact(10), 3628800)
    })

    测试用例("斐波那契递归", 函数() {
        函数 fib(n) {
            如果 n <= 1 { 返回 n }
            返回 fib(n - 1) + fib(n - 2)
        }
        断言相等(fib(0), 0)
        断言相等(fib(1), 1)
        断言相等(fib(2), 1)
        断言相等(fib(10), 55)
        断言相等(fib(15), 610)
    })

    测试用例("闭包捕获变量", 函数() {
        函数 makeAdder(n) {
            返回 函数(x) { 返回 x + n }
        }
        变量 add10 = makeAdder(10)
        变量 add20 = makeAdder(20)
        断言相等(add10(5), 15)
        断言相等(add20(5), 25)
    })

    测试用例("闭包可变状态", 函数() {
        函数 makeCounter() {
            变量 n = 0
            返回 函数() {
                n = n + 1
                返回 n
            }
        }
        变量 c = makeCounter()
        断言相等(c(), 1)
        断言相等(c(), 2)
        断言相等(c(), 3)
    })

    测试用例("高阶函数", 函数() {
        函数 apply(f, x) { 返回 f(x) }
        断言相等(apply(函数(n) { 返回 n * 2 }, 21), 42)
        断言相等(apply(函数(s) { 返回 大写(s) }, "abc"), "ABC")
    })

    测试用例("函数作为参数", 函数() {
        函数 map(arr, f) {
            变量 result = []
            变量 i = 0
            当 i < 长度(arr) {
                推入(result, f(arr[i]))
                i = i + 1
            }
            返回 result
        }
        变量 doubled = map([1, 2, 3], 函数(n) { 返回 n * 2 })
        断言相等(doubled[0], 2)
        断言相等(doubled[1], 4)
        断言相等(doubled[2], 6)
    })

    测试用例("命名函数递归", 函数() {
        函数 sum(n) {
            如果 n <= 0 { 返回 0 }
            返回 n + sum(n - 1)
        }
        断言相等(sum(10), 55)
        断言相等(sum(100), 5050)
    })

    测试用例("多参数函数", 函数() {
        函数 max3(a, b, c) {
            变量 m = a
            如果 b > m { m = b }
            如果 c > m { m = c }
            返回 m
        }
        断言相等(max3(1, 2, 3), 3)
        断言相等(max3(3, 2, 1), 3)
        断言相等(max3(1, 3, 2), 3)
    })
})

// ============================================================
// 套件 8：数学函数
// ============================================================
测试套件("数学函数", 函数() {

    测试用例("绝对值", 函数() {
        断言相等(绝对值(-42), 42)
        断言相等(绝对值(42), 42)
        断言相等(绝对值(0), 0)
        断言相等(绝对值(-3.14), 3.14)
    })

    测试用例("最大最小值", 函数() {
        断言相等(最大值(3, 7, 2, 9, 1), 9)
        断言相等(最小值(3, 7, 2, 9, 1), 1)
        断言相等(最大值(42), 42)
        断言相等(最小值(42), 42)
    })

    测试用例("取整函数", 函数() {
        断言相等(向上取整(3.1), 4)
        断言相等(向下取整(3.9), 3)
        断言相等(四舍五入(3.5), 4)
        断言相等(四舍五入(3.4), 3)
        断言相等(向上取整(3.0), 3)
        断言相等(向下取整(3.0), 3)
    })

    测试用例("幂运算", 函数() {
        断言相等(幂(2, 10), 1024.0)
        断言相等(幂(10, 2), 100.0)
        断言相等(幂(2, 0), 1.0)
    })

    测试用例("平方根", 函数() {
        断言相等(平方根(144), 12.0)
        断言相等(平方根(0), 0.0)
        断言相等(平方根(2), 1.4142135623730951)
    })

    测试用例("三角函数", 函数() {
        断言相等(正弦(0), 0.0)
        断言相等(余弦(0), 1.0)
    })

    测试用例("对数", 函数() {
        断言为真(对数(2.71828) > 0.999)
        断言为真(对数(2.71828) < 1.001)
        断言相等(对数(100, 10), 2.0)
    })

    测试用例("随机数范围", 函数() {
        变量 i = 0
        当 i < 100 {
            变量 r = 随机整数(1, 10)
            断言大于等于(r, 1)
            断言小于等于(r, 10)
            i = i + 1
        }
        变量 j = 0
        当 j < 100 {
            变量 f = 随机()
            断言大于等于(f, 0.0)
            断言小于(f, 1.0)
            j = j + 1
        }
    })
})

// ============================================================
// 套件 9：JSON
// ============================================================
测试套件("JSON", 函数() {

    测试用例("解析对象", 函数() {
        变量 data = json解析("{\"name\": \"zuzo\", \"version\": 1}")
        断言相等(data["name"], "zuzo")
        断言相等(data["version"], 1)
    })

    测试用例("解析数组", 函数() {
        变量 arr = json解析("[1, 2, 3]")
        断言相等(长度(arr), 3)
        断言相等(arr[0], 1)
        断言相等(arr[2], 3)
    })

    测试用例("解析嵌套", 函数() {
        变量 data = json解析("{\"list\": [1, 2], \"obj\": {\"x\": 42}}")
        断言相等(data["list"][0], 1)
        断言相等(data["list"][1], 2)
        断言相等(data["obj"]["x"], 42)
    })

    测试用例("解析布尔空值", 函数() {
        变量 data = json解析("{\"t\": true, \"f\": false, \"n\": null}")
        断言为真(data["t"])
        断言为假(data["f"])
        断言为空(data["n"])
    })

    测试用例("序列化", 函数() {
        变量 s = json序列化({"x": 42, "y": "hello"})
        断言包含(s, "x")
        断言包含(s, "42")
        断言包含(s, "y")
        断言包含(s, "hello")
    })

    测试用例("序列化数组", 函数() {
        变量 s = json序列化([1, 2, 3])
        断言包含(s, "1")
        断言包含(s, "2")
        断言包含(s, "3")
    })

    测试用例("JSON 往返", 函数() {
        变量 原始 = {"name": "test", "value": 123}
        变量 s = json序列化(原始)
        变量 还原 = json解析(s)
        断言相等(还原["name"], "test")
        断言相等(还原["value"], 123)
    })

    测试用例("JSON 格式化", 函数() {
        变量 s = json格式化({"a": 1}, "  ")
        断言包含(s, "a")
        断言包含(s, "1")
    })
})

// ============================================================
// 套件 10：正则表达式
// ============================================================
测试套件("正则表达式", 函数() {

    测试用例("正则匹配", 函数() {
        变量 m = 正则匹配("2024-01-15", "(\\d+)-(\\d+)-(\\d+)")
        断言非空(m)
        断言相等(m[0], "2024-01-15")
        断言相等(m[1], "2024")
        断言相等(m[2], "01")
        断言相等(m[3], "15")
    })

    测试用例("正则匹配无结果", 函数() {
        变量 m = 正则匹配("hello", "\\d+")
        断言为空(m)
    })

    测试用例("正则查找全部", 函数() {
        变量 all = 正则查找全部("a1b2c3", "\\d")
        断言相等(长度(all), 3)
        断言相等(all[0][0], "1")
        断言相等(all[1][0], "2")
        断言相等(all[2][0], "3")
    })

    测试用例("正则替换", 函数() {
        断言相等(正则替换("hello world", "\\w+", "x"), "x x")
        断言相等(正则替换("123-456", "\\d", "0"), "000-000")
    })

    测试用例("正则分割", 函数() {
        变量 parts = 正则分割("a,b;c", "[,;]")
        断言相等(长度(parts), 3)
        断言相等(parts[0], "a")
        断言相等(parts[1], "b")
        断言相等(parts[2], "c")
    })

    测试用例("正则验证", 函数() {
        断言为真(正则验证("test@example.com", "^[a-z]+@[a-z]+\\.[a-z]+$"))
        断言为假(正则验证("not-email", "^[a-z]+@[a-z]+\\.[a-z]+$"))
        断言为真(正则验证("12345", "^\\d+$"))
        断言为假(正则验证("12a45", "^\\d+$"))
    })

    测试用例("正则提取", 函数() {
        变量 r = 正则提取("价格: ¥99.99", "¥[\\d.]+")
        断言非空(r)
        断言相等(r, "¥99.99")
    })
})

// ============================================================
// 套件 11：f-string 插值
// ============================================================
测试套件("f-string 插值", 函数() {

    测试用例("纯文本", 函数() {
        断言相等(f"hello", "hello")
        断言相等(f"", "")
        断言相等(f"中文测试", "中文测试")
    })

    测试用例("变量插值", 函数() {
        变量 name = "zuzo"
        变量 version = 1
        断言相等(f"hello {name}", "hello zuzo")
        断言相等(f"v{version}", "v1")
    })

    测试用例("表达式插值", 函数() {
        变量 a = 3
        变量 b = 4
        断言相等(f"{a} + {b} = {a + b}", "3 + 4 = 7")
        断言相等(f"{a * b}", "12")
        断言相等(f"{a - b}", "-1")
    })

    测试用例("多变量插值", 函数() {
        变量 x = 1
        变量 y = 2
        变量 z = 3
        断言相等(f"{x},{y},{z}", "1,2,3")
    })

    测试用例("转义花括号", 函数() {
        断言相等(f"{{not var}}", "{not var}")
        断言相等(f"a{{b}}c", "a{b}c")
    })

    测试用例("浮点数插值", 函数() {
        变量 pi = 3.14
        断言相等(f"pi = {pi}", "pi = 3.14")
    })

    测试用例("布尔和空值插值", 函数() {
        断言相等(f"{真}", "真")
        断言相等(f"{假}", "假")
        断言相等(f"{空}", "空")
    })

    测试用例("数组插值", 函数() {
        变量 arr = [1, 2, 3]
        断言相等(f"arr = {arr}", "arr = [1, 2, 3]")
    })

    测试用例("嵌套引号", 函数() {
        变量 d = {"key": "val"}
        断言相等(f"{d["key"]}", "val")
    })
})

// ============================================================
// 套件 12：文件 I/O
// ============================================================
测试套件("文件 I/O", 函数() {

    测试前(函数() {
        删除文件("bdd_test_tmp.txt")
    })

    测试后(函数() {
        删除文件("bdd_test_tmp.txt")
    })

    测试用例("写入和读取", 函数() {
        写文件("bdd_test_tmp.txt", "hello zuzo")
        变量 content = 读文件("bdd_test_tmp.txt")
        断言相等(content, "hello zuzo")
    })

    测试用例("文件存在", 函数() {
        写文件("bdd_test_tmp.txt", "data")
        断言为真(文件存在("bdd_test_tmp.txt"))
        断言为假(文件存在("not_exist_file_xyz.hy"))
    })

    测试用例("追加文件", 函数() {
        写文件("bdd_test_tmp.txt", "line1\n")
        追加文件("bdd_test_tmp.txt", "line2\n")
        变量 content = 读文件("bdd_test_tmp.txt")
        断言相等(content, "line1\nline2\n")
    })

    测试用例("创建和删除", 函数() {
        创建文件("bdd_test_tmp.txt")
        断言为真(文件存在("bdd_test_tmp.txt"))
        删除文件("bdd_test_tmp.txt")
        断言为假(文件存在("bdd_test_tmp.txt"))
    })

    测试用例("重命名", 函数() {
        写文件("bdd_test_tmp.txt", "content")
        重命名("bdd_test_tmp.txt", "bdd_test_renamed.txt")
        断言为假(文件存在("bdd_test_tmp.txt"))
        断言为真(文件存在("bdd_test_renamed.txt"))
        删除文件("bdd_test_renamed.txt")
    })

    测试用例("读目录", 函数() {
        变量 entries = 读目录(".")
        断言大于(长度(entries), 0)
    })
})

// ============================================================
// 套件 13：并发
// ============================================================
测试套件("并发", 函数() {

    测试用例("并发执行返回结果", 函数() {
        变量 ch = 并发(函数() {
            返回 42
        })
        变量 result = 接收(ch)
        断言相等(result, 42)
    })

    测试用例("等待全部", 函数() {
        变量 ch1 = 并发(函数() { 返回 1 })
        变量 ch2 = 并发(函数() { 返回 2 })
        变量 ch3 = 并发(函数() { 返回 3 })
        变量 results = 等待全部(ch1, ch2, ch3)
        断言相等(长度(results), 3)
        断言相等(results[0], 1)
        断言相等(results[1], 2)
        断言相等(results[2], 3)
    })

    测试用例("通道发送接收", 函数() {
        变量 ch = 通道(1)
        发送(ch, "hello")
        变量 val = 接收(ch)
        断言相等(val, "hello")
    })

    测试用例("尝试接收非阻塞", 函数() {
        变量 ch = 通道(1)
        变量 val = 尝试接收(ch)
        断言为空(val)

        发送(ch, 99)
        变量 val2 = 尝试接收(ch)
        断言相等(val2, 99)
    })

    测试用例("关闭通道", 函数() {
        变量 ch = 通道(1)
        发送(ch, "data")
        关闭(ch)
        变量 val = 接收(ch)
        断言相等(val, "data")
    })

    测试用例("并发求和", 函数() {
        函数 计算(开始, 结束) {
            变量 总和 = 0
            变量 i = 开始
            当 i < 结束 {
                总和 = 总和 + i
                i = i + 1
            }
            返回 总和
        }
        变量 ch1 = 并发(函数() { 返回 计算(0, 50) })
        变量 ch2 = 并发(函数() { 返回 计算(50, 100) })
        变量 r = 等待全部(ch1, ch2)
        断言相等(r[0] + r[1], 4950)
    })
})

