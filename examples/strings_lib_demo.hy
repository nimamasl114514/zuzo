导入 "../libs/strings/main.hy" 为 串
打印("版本:", 串.版本)
打印("统计:", 串.统计("你好 world\n第二行"))
打印("摘要:", 串.摘要("你好世界abcdef", 8))
打印("摘要右:", 串.摘要右("C:/very/long/path/file.txt", 12))
打印("表格:")
打印(串.表格([["姓名", "年龄", "城市"], ["张三", "25", "北京"], ["李四", "30", "上海"]], [0, 0, 0], " | "))
打印("命名法-蛇形输入:", 串.命名法("user_name"))
打印("命名法-大驼峰输入:", 串.命名法("UserName"))
打印("模板:", 串.模板("你好，{名字}！你今年 {年龄} 岁。", {"名字": "张三", "年龄": 25}))
打印("去重行:", 串.去重行("a\nb\na\nc"))
打印("过滤空行:", 串.过滤空行("a\n\n b \n"))
打印("排序行:", 串.排序行("c\na\nb"))
打印("千分位:", 串.千分位(1234567))
打印("千分位负:", 串.千分位(-9876543))
打印("分割对:", 串.分割对("a=1, b=2", ",", "="))
打印("词频:", 串.词频("a b a c a"))
打印("重复到宽度:", 串.重复到宽度("ab", 7))
