// strlib_demo.hy — 文本 命名空间全量演示（第18轮）
// 运行：./zuzo.exe examples/strlib_demo.hy
打印("== 大小写 ==")
打印(文本.大写("Hello"))
打印(文本.小写("Hello"))
打印(文本.首字母大写("hello WORLD"))
打印(文本.标题化("hello world"))
打印(文本.大小写互换("AbC"))
打印(文本.大小写折叠("Straße"))
打印(文本.忽略大小写相等("AbC", "aBc"))
打印(文本.比较("a", "b"))

打印("== 裁剪/前后缀 ==")
打印(文本.去空白("  hi  ") + "|")
打印(文本.裁剪("xxhiyy", "xy"))
打印(文本.左裁剪("xxhi", "x"))
打印(文本.右裁剪("hixx", "x"))
打印(文本.去左空白("  hi") + "|")
打印(文本.去右空白("hi  ") + "|")
打印(文本.去前缀("prefix-body", "prefix-"))
打印(文本.去后缀("body.txt", ".txt"))
打印(文本.前缀("hello", "he"))
打印(文本.后缀("hello", "lo"))
打印(文本.前缀任一("hello", ["xx", "he"]))
打印(文本.后缀任一("hello", ["xx", "lo"]))
打印(文本.去除不可见("a" + 文本.码点转字符(8203) + "b"))

打印("== 查找/替换 ==")
打印(文本.查找("hello", "ll"))
打印(文本.反向查找("a.b.c", "."))
打印(文本.查找任一("hello", "lo"))
打印(文本.反向查找任一("hello", "lo"))
打印(文本.查找字符("hello", "l"))
打印(文本.包含("hello", "ell"))
打印(文本.包含任一("hello", "xyzl"))
打印(文本.计数("aaa", "a"))
打印(文本.替换("aaa", "a", "b"))
打印(文本.替换次("aaa", "a", "b", 2))
打印(文本.批量替换("a+b=c", {"a": "1", "b": "2", "c": "3"}))
打印(文本.替换字符("abc", {"a": "1", "b": "2"}))

打印("== 分割/连接 ==")
打印(文本.分割("a,b,c", ","))
打印(文本.分割次("a,b,c", ",", 2))
打印(文本.反向分割("a,b,c", ","))
打印(文本.反向分割次("a,b,c", ",", 2))
打印(文本.按行分割("a\nb\r\nc"))
打印(文本.分词("a  b\tc"))
打印(文本.分词按("a,b;c", ",;"))
打印(文本.连接(["a", "b", "c"], "-"))
打印(文本.位置分割("a=b", "="))
打印(文本.反向位置分割("a.b.c", "."))

打印("== 对齐/填充 ==")
打印(文本.左对齐("hi", 6, "-") + "|")
打印(文本.右对齐("hi", 6, "-") + "|")
打印(文本.居中("hi", 6, "-") + "|")
打印(文本.零填充("-42", 5))
打印(文本.重复("ab", 3))
打印(文本.展开制表符("a\tb", 4) + "|")

打印("== 判定 ==")
打印(文本.是数字("123"))
打印(文本.是十进制("123"))
打印(文本.是数值("123"))
打印(文本.是字母("abc"))
打印(文本.是字母数字("a1"))
打印(文本.是空白(" \t\n"))
打印(文本.是大写("ABC"))
打印(文本.是小写("abc"))
打印(文本.是标题("Hello World"))
打印(文本.是可打印("abc"))
打印(文本.是标识符("a1_"))
打印(文本.是ASCII("abc"))

打印("== 子串/反转 ==")
打印(文本.取字符("hello", 1))
打印(文本.子串("hello", 1, 4))
打印(文本.子串("hello", -3, -1))
打印(文本.取左("hello", 2))
打印(文本.取右("hello", 2))
打印(文本.反转("你好abc"))

打印("== 中文友好 ==")
打印(文本.显示宽度("你好ab"))
打印(文本.按宽度截断("你好世界abc", 6, "…"))
打印(文本.按宽度填充("你好", 8, "-", "左") + "|")
打印(文本.按宽度填充("你好", 8, "-", "右") + "|")
打印(文本.按宽度填充("你好", 8, "-", "中") + "|")
打印(文本.中文数字("一百二十三"))
打印(文本.中文数字("十二"))
打印(文本.中文数字("两万三千"))
打印(文本.中文数字串(123))
打印(文本.中文数字串(10086))
打印(文本.中文数字串(12))
打印(文本.包含中文("hello你好"))
打印(文本.全角转半角("ＡＢＣ１２３"))
打印(文本.半角转全角("ABC123"))

打印("== 复用面 ==")
打印(文本.base64编码("hello"))
打印(文本.正则匹配("abc123", "\\d+"))
