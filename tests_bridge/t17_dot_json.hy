// t17 点号 + 关键字参数 + 字典下标 + 属性错误路径
// 期望：序列化={"甲": 1} 反序列化={键: 2} 取键=2 属性错=E912 真
变量 json = py导入("json")
打印("[t17] 序列化=", json.dumps({"甲": 1}, ensure_ascii: 假))
变量 d = json.loads("{\"键\": 2}")
打印("[t17] 反序列化=", d, " 取键=", d["键"])
执行 { 打印(json.不存在) } 遇到 e { 打印("[t17] 属性错=", 错误码(e), 包含(错误信息(e), "不存在")) }
