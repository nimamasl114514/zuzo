// t08 值转换：大整数（超 int64）、布尔、None、字典、bytes、中文、嵌套
// 期望（python -c 现算）：2**70=1180591620717411303424（zuzo 落成字符串）
打印("[t08] 大整数=", py求值("2**70"), " 类型=", 类型(py求值("2**70")))
打印("[t08] 布尔=", py求值("True"), " 空=", py求值("None"), " 字典=", py求值("{'甲': 1, '乙': 2}"))
打印("[t08] 中文=", py求值("'你好' * 2"), " bytes64=", py求值("b'hi'"))
打印("[t08] 嵌套=", py求值("[[1,2],[3,[4,5]]]"))
