// t14 子进程重启后的旧句柄必须失效（防 ABA：新进程句柄表从 1 重分配，旧 ID 会指向别的对象）
// 期望：杀进程报错 → 重启可用 → 旧句柄报「失效」→ 新句柄正常
变量 旧 = py导入("os")
执行 { py执行("import os; os._exit(0)") } 遇到 e { 打印("[t14] 杀进程:", 错误码(e)) }
打印("[t14] 重启后求值:", py求值("1+1"))
执行 {
    打印("[t14] 旧句柄:", py取(旧, "name"))
} 遇到 e {
    打印("[t14] 旧句柄:", 错误码(e), 包含(错误信息(e), "失效"))
}
变量 新 = py导入("os")
打印("[t14] 新句柄可用:", 长度(py取(新, "name")))
