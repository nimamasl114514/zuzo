// t16 点号语法：属性/方法链/关键字参数/下标赋值（推荐写法，等价于 py取 + py调）
// 期望（python -c 现算）：形状=[2, 3] 和=21 行和=[6, 15] 转置=[[1, 4], [2, 5], [3, 6]]
//                       DataFrame 形状=[3, 2] 列和=10 分组=[{城市: 上海, 销量: 7}, {城市: 北京, 销量: 3}] 增列后=[3, 3]
变量 np = py导入("numpy")
变量 a = np.array([[1, 2, 3], [4, 5, 6]])
打印("[t16] 形状=", a.shape, " 和=", a.sum(), " 行和=", a.sum(1).tolist(), " 转置=", a.T.tolist())
变量 pd = py导入("pandas")
变量 df = pd.DataFrame({"城市": ["北京", "上海", "上海"], "销量": [3, 5, 2]})
打印("[t16] 形状=", df.shape, " 列和=", df["销量"].sum(), " 分组=", df.groupby("城市").sum().reset_index().to_dict("records"))
df["新列"] = [1, 1, 1]
打印("[t16] 增列后=", df.shape)
