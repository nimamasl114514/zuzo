// m11 容器往返 + 显式读写 + 高阶回调
##ZUZO
函数 求和(数列) {
  变量 总 = 0
  对于 i = 0; i < 长度(数列); i = i + 1 {
    总 = 总 + 数列[i]
  }
  返回 总
}
变量 全局数 = 123
##PY
print("zuzo.获取 全局数 =", zuzo.获取("全局数"))
print("py 调 zuzo 求和([1,2,3,4]) =", zuzo.调用("求和", [1, 2, 3, 4]))

def 映射(函数, 列表):
    return [函数(v) for v in 列表]

def 翻倍(v):
    return v * 2
##ZUZO
变量 结果 = py调用("映射", py获取("翻倍"), [1, 2, 3])
打印("回调往返 =", 结果)
py调用("print", "zuzo 调 py 内置 print")
