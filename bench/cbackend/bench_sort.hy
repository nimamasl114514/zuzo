函数 冒泡排序(数组) {
    变量 n = 长度(数组)
    对于 i = 0; i < n - 1; i = i + 1 {
        对于 j = 0; j < n - 1 - i; j = j + 1 {
            如果 数组[j] > 数组[j + 1] {
                变量 临时 = 数组[j]
                数组[j] = 数组[j + 1]
                数组[j + 1] = 临时
            }
        }
    }
    返回 数组
}
变量 数据 = []
变量 种子 = 12345
对于 i = 0; i < 200; i = i + 1 {
    种子 = (种子 * 1103515245 + 12345) % 2147483648
    推入(数据, 种子 % 10000)
}
变量 排序后 = 冒泡排序(数据)
打印(排序后[0], 排序后[199])
